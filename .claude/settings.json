{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/remind/remind.py\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/remind/remind.py\" pretool",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/remind/rules_gate.py\" bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|mcp__ccd_session__start_session|mcp__ccd_session__hand_off_to_session",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/remind/rules_gate.py\" spawn",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
