// <initializer_list>: the type the compiler itself makes for a braced
// list; its layout (a pointer and a count) is the compiler's, fixed by
// the C++ ABI.
#ifndef RP_CXX_INITIALIZER_LIST
#define RP_CXX_INITIALIZER_LIST
#include <stddef.h>
namespace std {
template <class T> class initializer_list {
    const T *first_;
    size_t count_;
    constexpr initializer_list(const T *first, size_t count) noexcept : first_(first), count_(count) {}

public:
    constexpr initializer_list() noexcept : first_(nullptr), count_(0) {}
    constexpr size_t size() const noexcept { return count_; }
    constexpr const T *begin() const noexcept { return first_; }
    constexpr const T *end() const noexcept { return first_ + count_; }
};
} // namespace std
#endif
