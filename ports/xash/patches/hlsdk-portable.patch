 	{
 		if( ( 1.0f - cosom ) > 0.000001f )
 		{
+#if XASH_RETROPANE
+			// RetroPane OS (no FPU; ADR-0039's FPS work, run 47: the client's
+			// bones 3.4% of the play, this slerp a quarter of its float adds and
+			// the double acos's helpers): the SDK's scalar way is one acos, three
+			// sin and two divides, all in doubles (software, ~2x a float's cost).
+			// Ours in floats (the inputs are floats) by the identity the SDK's own
+			// NEON path uses: sin((1 - t)w) = sin w cos tw - cos w sin tw, so
+			// sclp = cos tw - cos w sclq; sin w = sqrt((1 - c)(1 + c)): one acosf,
+			// one sinf, one cosf, one sqrtf, one divide. The same slerp.
+			omega = acosf( cosom );
+			sinom = sqrtf(( 1.0f - cosom ) * ( 1.0f + cosom ));
+			sclq = sinf( t * omega ) / sinom;
+			sclp = cosf( t * omega ) - cosom * sclq;
+#else
 			omega = acos( cosom );
 			sinom = sin( omega );
 			sclp = sin( ( 1.0f - t ) * omega ) / sinom;
 			sclq = sin( t * omega ) / sinom;
+#endif
 		}
 		else
 		{
