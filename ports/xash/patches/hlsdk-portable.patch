diff --git a/cl_dll/studio_util.cpp b/cl_dll/studio_util.cpp
index 441aca8..cafd671 100644
--- a/cl_dll/studio_util.cpp
+++ b/cl_dll/studio_util.cpp
@@ -36,8 +36,335 @@ ConcatTransforms
 
 ================
 */
+#if XASH_RETROPANE
+#include <stdint.h>
+// RetroPane OS (the Dell Axim X51v, no FPU): ConcatTransforms in integers.
+// Run 39's samples: the client's skeleton was 4.9% of the play in software
+// floats, ConcatTransforms half of it (36 multiplies and 27 adds a bone,
+// ~3,500 cycles). Iterate, don't imitate: the SDK's own way is floats (NEON
+// where there is one); ours takes each float's bits straight to fixed point
+// (rotation 4.28, offset 16.16), works the product in 32 x 32 -> 64
+// multiplies and makes the floats back from their bits, no helper call,
+// and keeps the float path for any value outside those ranges.
+static inline int rp_cf_fix( float f, int q, int32_t *out )
+{
+	uint32_t u, m;
+	int      sh;
+	int32_t  v;
+
+	__builtin_memcpy( &u, &f, sizeof( u ));
+	__asm__( "" : "+r"( u )); // the bit tests stay integer tests
+	if(( u & 0x7FFFFFFFu ) == 0 )
+	{
+		*out = 0;
+		return 1;
+	}
+	sh = (int)( u >> 23 & 0xFF ) - 127 - 23 + q;
+	if( sh < -24 )
+	{
+		*out = 0;
+		return 1;
+	}
+	if( sh > 7 ) // |f| at least 2^(31 - q): outside the range
+		return 0;
+	m = ( u & 0x007FFFFFu ) | 0x00800000u;
+	v = (int32_t)( sh >= 0 ? m << sh : m >> -sh );
+	*out = u >> 31 ? -v : v;
+	return 1;
+}
+
+static inline float rp_cf_float( int32_t v, int q )
+{
+	uint32_t a, s = 0, bits;
+	int      e;
+	float    f;
+
+	if( v == 0 )
+		return 0.0f;
+	if( v < 0 )
+	{
+		s = 0x80000000u;
+		a = 0u - (uint32_t)v;
+	}
+	else
+		a = (uint32_t)v;
+	e = 31 - __builtin_clz( a );
+	a = e > 23 ? a >> ( e - 23 ) : a << ( 23 - e );
+	bits = s | (uint32_t)( e - q + 127 ) << 23 | ( a & 0x007FFFFFu );
+	__builtin_memcpy( &f, &bits, sizeof( f ));
+	return f;
+}
+
+// R338's bisection (the throwables drawn stretched in hand): -rpnocf the
+// SDK's ConcatTransforms, -rpnoq the SDK's quaternions (all three)
+static int rp_r338_off( int *flag, const char *word )
+{
+	if( *flag < 0 )
+		*flag = gEngfuncs.CheckParm( (char *)word, NULL ) != 0;
+	return *flag;
+}
+static int rp_nocf = -1, rp_noq = -1;
+
+// 1 when done in integers, 0 when a value is out of range (the caller's
+// floats then).
+static inline int rp_concat_fixed( float in1[3][4], float in2[3][4], float out[3][4] )
+{
+	int32_t a[3][4], b[3][4];
+
+	for( int i = 0; i < 3; i++ )
+		for( int j = 0; j < 4; j++ )
+			if( !rp_cf_fix( in1[i][j], j == 3 ? 16 : 28, &a[i][j] ) || !rp_cf_fix( in2[i][j], j == 3 ? 16 : 28, &b[i][j] ))
+				return 0;
+	for( int i = 0; i < 3; i++ )
+	{
+		for( int j = 0; j < 4; j++ )
+		{
+			int64_t sum = (int64_t)a[i][0] * b[0][j] + (int64_t)a[i][1] * b[1][j] + (int64_t)a[i][2] * b[2][j];
+			int64_t r = sum >> 28;
+
+			if( j == 3 )
+				r += a[i][3];
+			if( r > 0x7FFFFFFF || r < -0x7FFFFFFF )
+				return 0;
+			out[i][j] = rp_cf_float( (int32_t)r, j == 3 ? 16 : 28 );
+		}
+	}
+	return 1;
+}
+#endif // XASH_RETROPANE
+
+#if XASH_RETROPANE
+// RetroPane OS (the Dell Axim X51v, no FPU; ADR-0039's FPS work, kit 51,
+// R306): the rest of the client's skeleton in integers. Run 50's samples:
+// the client's software floats 3.4% of the play (rp_fadd 1.7%, rp_fmul
+// 1.7%), all but a little from QuaternionMatrix, QuaternionSlerp and
+// AngleQuaternion, and AngleQuaternion's six sin/cos in doubles on top.
+// Iterate, don't imitate: the SDK's way is floats with libm (NEON's
+// sin_ps/acos_ps where there is NEON); a fixed-point skeleton is how the
+// float-less consoles of HL's day did it (a 4096-entry sine table, no
+// slerp). Ours: the floats' bits straight to 2.30 (rp_cf_fix, no helper
+// call), the half angles' sines from a quarter-wave table of 1,025 2.30
+// entries read linearly (within 3e-7 of sin, and relatively exact near
+// 0, where adjacent frames' slerps live), the slerp's angle by CORDIC
+// (28 shift-and-add steps, no acos) from the cosine and the length of q's
+// part across p (exact to the last bit for small angles, where
+// sqrt(1 - c^2) loses half its bits), one 64-bit divide for both weights;
+// the floats made back from their bits. The same quaternions to within
+// 1e-6 (checked against doubles over 20,000 random cases: 1e-4 units on a
+// 100-unit bone, far under a pixel); any value out of range takes the
+// SDK's float path.
+static int32_t  rp_qsin[1025]; // sin(i pi / 2048), 2.30
+static uint32_t rp_qatan[28];  // atan(2^-i) in turns x 2^32
+static int      rp_q_ready;
+
+static void rp_q_init( void )
+{
+	for( int i = 0; i <= 1024; i++ )
+		rp_qsin[i] = (int32_t)( sin( i * ( M_PI / 2048.0 )) * 1073741824.0 + 0.5 );
+	for( int i = 0; i < 28; i++ )
+		rp_qatan[i] = (uint32_t)( atan( ldexp( 1.0, -i )) / ( 2.0 * M_PI ) * 4294967296.0 + 0.5 );
+	rp_q_ready = 1;
+}
+
+// sin of a phase (a turn is 2^32), 2.30
+static inline int32_t rp_qsin_at( uint32_t ph )
+{
+	uint32_t x = ph & 0x3FFFFFFFu;
+	int32_t  v;
+	uint32_t i, f;
+
+	if( ph & 0x40000000u )
+		x = 0x40000000u - x; // the quarter mirrored
+	i = x >> 20;
+	f = x & 0xFFFFFu; // all 20 bits: a phase's last bits are the small angles' (adjacent frames)
+	v = i >= 1024 ? rp_qsin[1024] : rp_qsin[i] + (int32_t)(( (int64_t)( rp_qsin[i + 1] - rp_qsin[i] ) * f ) >> 20 );
+	return ( ph & 0x80000000u ) ? -v : v;
+}
+
+static inline int32_t rp_qmul( int32_t a, int32_t b )
+{
+	return (int32_t)(( (int64_t)a * b ) >> 30 );
+}
+
+// a half angle's phase from radians (|a| below 128): a x 2^32 / 4 pi
+static inline int rp_q_half( float a, uint32_t *ph )
+{
+	int32_t v;
+
+	if( !rp_cf_fix( a, 24, &v ))
+		return 0;
+	*ph = (uint32_t)(( (int64_t)v * 341782638 ) >> 24 ); // 2^32 / 4 pi
+	return 1;
+}
+
+static int rp_angle_quaternion( const float *angles, vec4_t q )
+{
+	uint32_t py, pp, pr;
+	int32_t  sy, cy, sp, cp, sr, cr, srcp, crsp, crcp, srsp;
+
+	if( !rp_q_ready )
+		rp_q_init();
+	if( !rp_q_half( angles[2], &py ) || !rp_q_half( angles[1], &pp ) || !rp_q_half( angles[0], &pr ))
+		return 0;
+	sy = rp_qsin_at( py );
+	cy = rp_qsin_at( py + 0x40000000u );
+	sp = rp_qsin_at( pp );
+	cp = rp_qsin_at( pp + 0x40000000u );
+	sr = rp_qsin_at( pr );
+	cr = rp_qsin_at( pr + 0x40000000u );
+	srcp = rp_qmul( sr, cp );
+	crsp = rp_qmul( cr, sp );
+	crcp = rp_qmul( cr, cp );
+	srsp = rp_qmul( sr, sp );
+	q[0] = rp_cf_float( rp_qmul( srcp, cy ) - rp_qmul( crsp, sy ), 30 ); // X
+	q[1] = rp_cf_float( rp_qmul( crsp, cy ) + rp_qmul( srcp, sy ), 30 ); // Y
+	q[2] = rp_cf_float( rp_qmul( crcp, sy ) - rp_qmul( srsp, cy ), 30 ); // Z
+	q[3] = rp_cf_float( rp_qmul( crcp, cy ) + rp_qmul( srsp, sy ), 30 ); // W
+	return 1;
+}
+
+static int rp_quaternion_matrix( const vec4_t q, float ( *m )[4] )
+{
+	int32_t x, y, z, w;
+
+	if( !rp_cf_fix( q[0], 30, &x ) || !rp_cf_fix( q[1], 30, &y ) || !rp_cf_fix( q[2], 30, &z ) || !rp_cf_fix( q[3], 30, &w ))
+		return 0;
+	{
+		// the doubled products: 2ab as (ab) << 1, 2.30 (each within +-2)
+		int32_t xx = rp_qmul( x, x ), yy = rp_qmul( y, y ), zz = rp_qmul( z, z );
+		int32_t xy = rp_qmul( x, y ), xz = rp_qmul( x, z ), yz = rp_qmul( y, z );
+		int32_t wx = rp_qmul( w, x ), wy = rp_qmul( w, y ), wz = rp_qmul( w, z );
+		const int32_t one = 0x40000000;
+
+		if( xx + yy + zz > one + ( one >> 2 ))
+			return 0; // far from a unit quaternion: the doubled sums leave 2.30
+		m[0][0] = rp_cf_float( one - 2 * ( yy + zz ), 30 );
+		m[1][0] = rp_cf_float( 2 * ( xy + wz ), 30 );
+		m[2][0] = rp_cf_float( 2 * ( xz - wy ), 30 );
+		m[0][1] = rp_cf_float( 2 * ( xy - wz ), 30 );
+		m[1][1] = rp_cf_float( one - 2 * ( xx + zz ), 30 );
+		m[2][1] = rp_cf_float( 2 * ( yz + wx ), 30 );
+		m[0][2] = rp_cf_float( 2 * ( xz + wy ), 30 );
+		m[1][2] = rp_cf_float( 2 * ( yz - wx ), 30 );
+		m[2][2] = rp_cf_float( one - 2 * ( xx + yy ), 30 );
+	}
+	return 1;
+}
+
+// sqrt of a 64-bit value, rounded down (bit by bit: 32 steps)
+static inline uint32_t rp_isqrt64( uint64_t v )
+{
+	uint64_t r = 0, bit = (uint64_t)1 << 62;
+
+	while( bit > v )
+		bit >>= 2;
+	while( bit )
+	{
+		if( v >= r + bit )
+		{
