+			sclq = (int32_t)(( (int64_t)st * inv ) >> 30 );
+			sclp = (int32_t)(( (int64_t)s1 * inv ) >> 30 );
+		}
+		else
+		{
+			sclp = 0x40000000 - tf;
+			sclq = tf;
+		}
+	}
+	for( int i = 0; i < 4; i++ )
+		qt[i] = rp_cf_float( rp_qmul( a[i], sclp ) + rp_qmul( b[i], sclq ), 30 );
