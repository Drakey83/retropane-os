+			for( int i = 0; i < 4; i++ )
+			{
+				int32_t r = b[i] - rp_qmul( c, a[i] );
+
+				ss += (uint64_t)( (int64_t)r * r );
+			}
+			s = rp_isqrt64( ss );
+			// w = atan2(s, c) by CORDIC (first quadrant), a turn as 2^32
+			x = c;
+			y = s;
+			for( int i = 0; i < 28; i++ )
+			{
+				int64_t nx;
+
+				if( y > 0 )
+				{
+					nx = x + ( y >> i );
+					y -= x >> i;
+					ph += rp_qatan[i];
+				}
+				else
+				{
+					nx = x - ( y >> i );
+					y += x >> i;
+					ph -= rp_qatan[i];
+				}
