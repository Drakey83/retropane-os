diff --git a/BaseMenu.h b/BaseMenu.h
index ae05457..3a959c7 100755
--- a/BaseMenu.h
+++ b/BaseMenu.h
@@ -161,6 +161,38 @@ inline bool UI_CursorInRect( Point pos, Size size )
 	return UI_CursorInRect( pos.x, pos.y, size.w, size.h );
 }
 
+/*
+RetroPane R351 (the owner, 2026-11-21: "the options and menu option sliders
+arent adjustable by the stylus"). Measured in the emulator with scripted
+taps: on the X51v's 640 x 480 the menu's 1024 x 768 layout is scaled by
+0.625, so a slider's bar is 187 x 8 pixels (under 1 mm high on the 3.7 inch
+panel) and a check box 20 x 20; a tap on the bar moved the slider, a tap 7
+pixels under it did nothing. Rule 0: the menu's hit test is the drawn
+rectangle, sized for a mouse pointer (one pixel wide, seen before the
+click); a stylus has no pointer to aim with and lands within a couple of
+millimetres. So a control's rectangle as the stylus may hit it is never
+smaller than UI_STYLUS_MIN pixels either way (3.3 mm on this panel),
+grown about its centre; the drawn control is not changed, and the items
+holder tries the drawn rectangles first, so a grown one never takes a
+press that lies on a neighbour.
+*/
+#define UI_STYLUS_MIN 28
+
+inline bool UI_CursorInStylusRect( Point pos, Size size )
+{
+	if( size.w < UI_STYLUS_MIN )
+	{
+		pos.x -= ( UI_STYLUS_MIN - size.w ) / 2;
+		size.w = UI_STYLUS_MIN;
+	}
+	if( size.h < UI_STYLUS_MIN )
+	{
+		pos.y -= ( UI_STYLUS_MIN - size.h ) / 2;
+		size.h = UI_STYLUS_MIN;
+	}
+	return UI_CursorInRect( pos.x, pos.y, size.w, size.h );
+}
+
 // temporarily override alpha by multiplying given alpha and factor
 void UI_EnableAlphaFactor( float a );
 void UI_DisableAlphaFactor();
