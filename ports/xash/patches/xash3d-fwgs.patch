+#if defined( __retropane__ )
+/*
+Kit 83 (R324, run 82: the sky check's surface walk, PM_RecursiveSurfCheck
+and its floats, ~5% of the cascade's heavy half, one a model a frame).
+Iterate (rule 0): Xash walks the world's nodes in floats to the first face
+the line meets (its bevel planes) for each model; ours walks the same
+nodes in the same order in 16.16 integers (planes read from their float
+bits), the bevel's sphere and edge planes tested in integers. A face with
+a see-through texture ("{": its texel decides) hands the line to the
+engine's float walk, as does a world not at the origin.
+*/
+#define RP_SURF_FLOAT ( (msurface_t *)(uintptr_t)1 )
+
+static inline int64_t RP_LFix64( float f )
+{
+	/* f x 2^16 as 64 bits (a bevel's squared radius passes 2^15) */
+	uint32_t u, m;
+	int      e;
+	int64_t  v;
+
+	__builtin_memcpy( &u, &f, sizeof( u ));
+	__asm__( "" : "+r"( u ));
+	e = (int)( u >> 23 & 0xFF ) - 127 + 16;
+	if( e < 0 )
+		return 0;
+	if( e > 60 )
+		return u >> 31 ? -INT64_MAX : INT64_MAX;
+	m = ( u & 0x007FFFFFu ) | 0x00800000u;
+	v = e >= 23 ? (int64_t)m << ( e - 23 ) : (int64_t)( m >> ( 23 - e ));
+	return u >> 31 ? -v : v;
+}
+
+static msurface_t *RP_SurfFix( model_t *mod, mnode_t *node, const int32_t p1[3], const int32_t p2[3] )
+{
+	const int32_t eps = 64; /* FRAC_EPSILON, 1/1024, in 16.16 */
+loc0:
+	if( node->contents < 0 )
+		return NULL;
+
+	int32_t t1 = RP_LPlane( node->plane, p1 );
+	int32_t t2 = RP_LPlane( node->plane, p2 );
+
+	if( t1 >= -eps && t2 >= -eps )
+	{
+		node = node_child( node, 0, mod );
+		goto loc0;
+	}
+	if( t1 < eps && t2 < eps )
+	{
+		node = node_child( node, 1, mod );
+		goto loc0;
+	}
+
+	int     side = t1 < 0;
+	int32_t frac = (int32_t)(( (int64_t)t1 << 16 ) / ( (int64_t)t1 - t2 ));
+
+	frac = frac < 0 ? 0 : frac > ( 1 << 16 ) ? ( 1 << 16 ) : frac;
+
+	int32_t mid[3];
+
+	for( int k = 0; k < 3; k++ )
+		mid[k] = p1[k] + (int32_t)(( (int64_t)( p2[k] - p1[k] ) * frac ) >> 16 );
+
+	msurface_t *surf = RP_SurfFix( mod, node_child( node, side, mod ), p1, mid );
+
+	if( surf != NULL )
+		return surf;
+
+	int numsurfaces = node_numsurfaces( node, mod );
+	int firstsurface = node_firstsurface( node, mod );
+
+	for( int i = 0; i < numsurfaces; i++ )
+	{
+		msurface_t   *sf = &mod->surfaces[firstsurface + i];
+		mfacebevel_t *fb = sf->info->bevel;
+		int64_t       d2 = 0;
+		int           j;
+
+		if( !fb )
+			continue;
+		for( int k = 0; k < 3; k++ )
+		{
+			int64_t d = (int64_t)mid[k] - RP_LFix( fb->origin[k], 16 );
+
+			d2 += ( d * d ) >> 16;
+		}
+		if( d2 >= RP_LFix64( fb->radius ))
+			continue; // no intersection
+		for( j = 0; j < fb->numedges; j++ )
+		{
+			if( RP_LPlane( &fb->edges[j], mid ) > eps )
+				break; // outside the bounds
+		}
+		if( j != fb->numedges )
+			continue;
+		if( sf->texinfo && sf->texinfo->texture && sf->texinfo->texture->name[0] == '{' )
+			return RP_SURF_FLOAT; // its texel decides: the engine's walk
+		return sf; // the face's own contents (sky or solid), as PM_SampleMiptex
+	}
+
+	return RP_SurfFix( mod, node_child( node, side ^ 1, mod ), mid, p2 );
+}
+#endif
