+		Q_free( mem );
+		return NULL;
+	}
+	big = rp_big_size( mem );
+	if( !big && size < RP_BIG )
+		return realloc( mem, size );
+	old = big ? big : malloc_usable_size( mem );
+	newmem = Q_malloc( size );
+	if( !newmem )
+		return NULL;
+	memcpy( newmem, mem, old < size ? old : size );
+	Q_free( mem );
+	return newmem;
