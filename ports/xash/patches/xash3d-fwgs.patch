+		uint32_t         wx = k & 1 ? ax : 256 - ax, wy = k & 2 ? ay : 256 - ay, wz = k & 4 ? az : 256 - az;
+		uint32_t         w = (( wx * wy ) >> 8 ) * wz >> 8; /* up to 256 */
+
+		if( !g->mode || !w )
+			continue;
+		sum[0] += w * g->rgb[0];
+		sum[1] += w * g->rgb[1];
+		sum[2] += w * g->rgb[2];
+		zsum += (int64_t)w * g->spotz;
+		wsum += w;
+	}
+	if( wsum )
+	{
+		out.r = ( sum[0] + wsum / 2 ) / wsum;
+		out.g = ( sum[1] + wsum / 2 ) / wsum;
+		out.b = ( sum[2] + wsum / 2 ) / wsum;
+	}
+	if( spot )
+	{
+		VectorCopy( p, spot );
+		if( wsum )
+			spot[2] = (float)( zsum / (int64_t)wsum );
+		else
+			VectorClear( spot );
+	}
+	return out;
