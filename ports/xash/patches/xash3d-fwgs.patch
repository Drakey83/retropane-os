 static inline short UnalignedShort( short *x )
 {
+#if defined( __retropane__ ) && defined( __arm__ )
+	// RetroPane (kit 67, run 64: ~250 samples of two-byte memcpy calls in
+	// the bones' code): two byte loads in assembly, so never a halfword
+	// load at an odd address (R280) and never a call; the same short
+	unsigned int lo, hi;
+
+	__asm__( "ldrb %0, [%2]\n\tldrb %1, [%2, #1]" : "=&r"( lo ), "=&r"( hi ) : "r"( x ), "m"( *(const char (*)[2])x ));
