+static uint64_t RP_LightKey( void )
+{
+	uint64_t h = 0xCBF29CE484222325ULL;
+
+	if( rp_elight_time == gp_cl->time )
+		return rp_elight_key;
+	rp_elight_time = gp_cl->time;
+	h = RP_Fnv( h, g_lightstylevalue, sizeof( g_lightstylevalue ));
+	h = RP_Fnv( h, gp_movevars->skycolor, sizeof( gp_movevars->skycolor ));
+	h = RP_Fnv( h, gp_movevars->skyvec, sizeof( gp_movevars->skyvec ));
+	h = RP_Fnv( h, &gp_cl->models[1], sizeof( gp_cl->models[1] ));
+	h = RP_Fnv( h, &r_lighting_extended.value, sizeof( r_lighting_extended.value ));
+	for( int i = 0; i < MAX_PHYSENTS; i++ )
+	{
+		const physent_t *pe = gEngfuncs.EV_GetPhysent( i );
+
+		if( !pe )
+			break;
+		if( !pe->model || pe->model->type != mod_brush )
+			continue;
+		h = RP_Fnv( h, &pe->model, sizeof( pe->model ));
+		h = RP_Fnv( h, pe->origin, sizeof( pe->origin ));
+		h = RP_Fnv( h, pe->angles, sizeof( pe->angles ));
+	}
+	rp_elight_key = h;
+	return h;
+}
