+/* One more chunk on the free list, while under max_tents: 1, or 0. */
+static int CL_TentGrow( void )
+{
+	TEMPENTITY *c;
+
+	if( cl_tent_chunks >= RP_TENT_CHUNKS || ( cl_tent_chunks + 1 ) * RP_TENT_CHUNK > GI->max_tents )
+		return 0;
+	if( !( c = calloc( RP_TENT_CHUNK, sizeof( TEMPENTITY ))))
+		return 0;
+	cl_tent_chunk[cl_tent_chunks++] = c;
+	for( int i = RP_TENT_CHUNK - 1; i >= 0; i-- )
+	{
+		c[i].entity.trivial_accept = INVALID_HANDLE;
+		c[i].next = cl_free_tents;
+		cl_free_tents = &c[i];
+	}
+	return 1;
+}
+
+/* A temporary entity's number in the pool (its sound's entity). */
+static int CL_TentIndex( const TEMPENTITY *p )
+{
+	for( int c = 0; c < cl_tent_chunks; c++ )
+		if( p >= cl_tent_chunk[c] && p < cl_tent_chunk[c] + RP_TENT_CHUNK )
+			return c * RP_TENT_CHUNK + (int)( p - cl_tent_chunk[c] );
+	return 0;
+}
