+typedef struct
+{
+	int32_t  n[3];      /* RP_LFix( normal, 30 ); an axial plane: n[0] = RP_LN_AXIAL + its type */
+	int32_t  d;         /* RP_LFix( dist, 16 ) */
+	int16_t  child[2];  /* node numbers; -1 a leaf (or none) */
+	uint16_t firstsurf, numsurf;
+} rp_lnode_t;
+
+#define RP_LN_AXIAL ( (int32_t)0x80000000 )
