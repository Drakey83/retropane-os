+{
+	const cl_entity_t *ent;
+	const model_t     *model;
+	unsigned           stamp;
+	vec3_t             org;
+	int                effects, renderfx, iuser4, draw_world;
+	double             time;
+	uint64_t           key;
+	float              fullbright, dynamic, direct;
+	/* what it wrote */
+	int                ambientlight, shadelight;
+	vec3_t             color, vec;
