+   stale one for it; NULL if none */
+static rp_pre_t *RP_PreSlot( const cl_entity_t *ent, int take )
+{
+	uint32_t h = (uint32_t)(uintptr_t)ent * 2654435761u >> 22; /* 10 bits */
+
+	for( int k = 0; k < RP_PRE_PROBE; k++ )
+	{
+		rp_pre_t *p = &rp_pre[( h + k ) & ( RP_PRE - 1 )];
