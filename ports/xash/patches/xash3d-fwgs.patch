+/*
+=================
+RP_SurfLightmap
+
+ref_rp (R297 option B, ADR-0039): the face's lightmap as RGB565, one texel
+a light sample, for the 2700G to multiply into the texture in a second
+pass. R_BuildLightMap sums the samples' three channels into one grey (the
+software renderer's 32 light levels); ref_gl keeps the colours. Here each
+channel goes through R_BuildLightMap's own scale and gamma (as if all
+three were that channel), so a grey light gives ref_soft's level exactly
+and a coloured one the GL look. Dynamic lights add their grey as
+R_AddDynamicLights does. 0 if the face's samples don't fit `room`; else
+1, | 2 when a dynamic light was in it.
+=================
+*/
+int RP_SurfLightmap( msurface_t *surf, unsigned short *out, int room, int *pw, int *ph )
+{
+	const mextrasurf_t *info = surf->info;
+	const int          sample_size = gEngfuncs.Mod_SampleSizeForFace( surf );
+	const int          smax = ( info->lightextents[0] / sample_size ) + 1;
+	const int          tmax = ( info->lightextents[1] / sample_size ) + 1;
+	const int          size = smax * tmax;
+	const int          dlit = surf->dlightframe == tr.framecount;
+	uint               scale[MAXLIGHTMAPS];
+	int                maps;
+
+	if( size > room || size > (int)ARRAYSIZE( blocklights ) || FBitSet( surf->flags, SURF_CONVEYOR ))
+		return 0;
+	*pw = smax;
+	*ph = tmax;
+	memset( blocklights, 0, sizeof( uint ) * size );
+	if( dlit )
+		R_AddDynamicLights( surf );
+	for( maps = 0; maps < MAXLIGHTMAPS && surf->samples && surf->styles[maps] != 255; maps++ )
+		scale[maps] = g_lightstylevalue[surf->styles[maps]] * 3;
+	R_UpdateSurfaceCachedLight( surf );
+	for( int i = 0; i < size; i++ )
+	{
+		uint c[3];
+		int  t[3];
+
+		c[0] = c[1] = c[2] = blocklights[i];
+		for( int map = 0; map < maps; map++ )
+		{
+			const color24 *lm = &surf->samples[map * size + i];
+
+			c[0] += lm->r * scale[map];
+			c[1] += lm->g * scale[map];
+			c[2] += lm->b * scale[map];
+		}
+		for( int k = 0; k < 3; k++ )
+		{
+			int v = c[k] < 65280 ? (int)( LightToTexGamma( c[k] >> 6 ) << 6 ) : (int)c[k];
+
+			v = bound( 0, v, 65535 * 3 );
+			t[k] = v / 2048 / 3; /* 0-31, R_BuildLightMap's level */
+		}
+		out[i] = (unsigned short)( t[0] << 11 | ( t[1] << 1 | t[1] >> 4 ) << 5 | t[2] );
+	}
+	return dlit ? 3 : 1;
+}
