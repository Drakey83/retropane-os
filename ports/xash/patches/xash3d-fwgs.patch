+/* a float's whole part (toward zero) by its bits, saturated at 2^30 */
+static inline int32_t RP_FloatUnits( float f )
+{
+	uint32_t u;
+	int      e;
+	int32_t  v;
+
+	memcpy( &u, &f, 4 );
+	e = (int)( u >> 23 & 0xFF ) - 127;
+	if( e < 0 )
+		return 0;
+	if( e >= 30 )
+		v = 1 << 30;
+	else
+		v = (int32_t)(( u & 0x007FFFFFu | 0x00800000u ) >> ( e <= 23 ? 23 - e : 0 ) << ( e > 23 ? e - 23 : 0 ));
+	return u >> 31 ? -v : v;
+}
+
+static int32_t rp_debris_eye_u[3];
+
+static __attribute__(( noinline )) int RP_DebrisCandidate( cl_entity_t *e )
+{
+	uint64_t q = 0;
+
+	if( !rp_cand_on || rp_debris_cap_n < 0 || e->index || e->model->type != mod_studio
+		|| e->curstate.rendermode != kRenderNormal || rp_ncand >= (int)( sizeof( rp_cand ) / sizeof( rp_cand[0] )))
+		return 0;
