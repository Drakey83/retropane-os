+/*
+RetroPane R335 (docs/design/ref-rp.md "Texture memory"): Half-Life's
+textures, skins and sprites are 8-bit images with their own palette;
+ref_soft kept each as 16-bit pixel_t at four mip levels plus an alpha
+copy (2.7 to 3.7 bytes a texel: 12.4 MiB of c2a5f's 38 MiB heap), though
+on the 2700G path the chip holds the texture and the CPU reads the RAM
+copy only to write it there again or to light a face it still lights.
+Quake and GoldSrc kept 8 bits and a palette and read through it on every
+texel; ref_gl gives the texels to GL and reads the file again when the
+context is lost. Ours: at upload a texture of at most 256 colours keeps
+its 8-bit indices and those exact RGBA colours (found from the texels
+themselves, so any source and any processing before the upload counts),
+and its 16-bit levels are rebuilt when a reader asks, by the same code on
+the same bytes (the colours expanded, GL_BuildMipMap, R_TexLevel), into a
+fixed ring (Quake's surface-cache allocator: the oldest blocks give way,
+blocks handed out this frame never do). The picture cannot change, one
+byte a texel stays (about 1 instead of 2.7), nothing is read from the
+card again, and the ring is one block for the game's life (no holes:
+R310's lesson). `-rpnotexpal` keeps the old way (the A/B); `-rptexcheck`
+rebuilds every texture at upload and compares it with the old way's.
+*/
+typedef struct r_tent_s
+{
+	image_t          *owner;   // NULL: free
+	uint32_t         size;     // the block's bytes, this header included
+	uint32_t         stamp;    // r_ring_frame when last handed out
+	byte             from;     // the first level held
+	byte             to;       // the last level held
+	byte             heap;     // 1: from the heap (the ring was full), freed next frame
+	byte             pad;
+	pixel_t          *lv[4];
+	pixel_t          *alpha;
+	struct r_tent_s  *next_heap;
+} r_tent_t;
+
+#define R_RING_BYTES ( 1024 * 1024 )
+static byte      *r_ring;
+static uint32_t  r_ring_size, r_ring_head, r_ring_frame = 2, r_texserial;
+static r_tent_t  *r_ring_heap;
+static int       r_texpal_on = -1, r_texcheck;
+static struct
+{
+	uint32_t decodes, bytes, evicts, heap, heap_bytes;        // since the last stats line
+	uint32_t pal, pal_b, full, full_b, saved_b, bad;          // uploads since the start
+} r_ring_count;
+image_t *r_skin_img;
+int     r_skin_alpha;
+// every rebuild since the start, and the slowest's microseconds (in_rp.c's
+// per-frame report reads and clears it)
+uint32_t rp_tex_rebuilds, rp_tex_rebuild_us_max;
+uint64_t rp_time_us( void );
+
+static void R_TentDrop( r_tent_t *b )
+{
+	if( b->owner )
+	{
+		b->owner->rp_ent = NULL;
+		b->owner = NULL;
+		r_ring_count.evicts++;
+	}
+}
+
+/* `need` body bytes: the blocks from the ring's head on, as many as it
+   takes (none handed out this frame), or a heap block when they won't do. */
+static r_tent_t *R_RingAlloc( uint32_t need )
+{
+	r_tent_t *b;
+
+	need = ( need + (uint32_t)sizeof( r_tent_t ) + 7u ) & ~7u;
+	if( r_ring && need <= r_ring_size )
+	{
+		uint32_t start = r_ring_head, scanned = 0;
+
+		while( scanned <= 2u * r_ring_size )
+		{
+			uint32_t pos, got = 0;
+			r_tent_t *blk = NULL;
+
+			if( start >= r_ring_size )
+				start = 0;
+			pos = start;
+			while( got < need && pos < r_ring_size )
+			{
+				blk = (r_tent_t *)( r_ring + pos );
+				if( blk->owner && blk->stamp == r_ring_frame )
+					break;
+				got += blk->size;
+				pos += blk->size;
+			}
+			if( got >= need )
+			{
+				for( uint32_t p = start; p < pos; p += ( (r_tent_t *)( r_ring + p ))->size )
+					R_TentDrop( (r_tent_t *)( r_ring + p ));
+				if( got - need >= sizeof( r_tent_t ))
+				{
+					r_tent_t *rest = (r_tent_t *)( r_ring + start + need );
+
+					memset( rest, 0, sizeof( *rest ));
+					rest->size = got - need;
+				}
+				else
+					need = got;
+				b = (r_tent_t *)( r_ring + start );
+				memset( b, 0, sizeof( *b ));
+				b->size = need;
+				r_ring_head = start + need;
+				return b;
+			}
+			if( pos >= r_ring_size )
+			{
+				scanned += pos - start;
+				start = 0;
+			}
+			else
+			{
+				scanned += pos - start + blk->size;
+				start = pos + blk->size;
+			}
+		}
+	}
+	b = (r_tent_t *)Mem_Calloc( r_temppool, need );
+	b->size = need;
+	b->heap = 1;
+	b->next_heap = r_ring_heap;
+	r_ring_heap = b;
+	r_ring_count.heap++;
+	r_ring_count.heap_bytes += need;
+	return b;
+}
+
+/* The newest block cut to `keep` body bytes (its tail was the scratch). */
+static void R_RingShrink( r_tent_t *b, uint32_t keep )
+{
+	r_tent_t *rest;
+
+	keep = ( keep + (uint32_t)sizeof( r_tent_t ) + 7u ) & ~7u;
+	if( b->heap || b->size - keep < sizeof( r_tent_t ))
+		return;
+	rest = (r_tent_t *)((byte *)b + keep );
+	memset( rest, 0, sizeof( *rest ));
+	rest->size = b->size - keep;
+	b->size = keep;
+	if( r_ring_head == (uint32_t)((byte *)rest - r_ring ) + rest->size )
+		r_ring_head = (uint32_t)((byte *)rest - r_ring );
+}
+
+void R_TexRingFrame( void )
+{
+	r_ring_frame++;
+	while( r_ring_heap )
+	{
+		r_tent_t *next = r_ring_heap->next_heap;
+
+		if( r_ring_heap->owner )
+			r_ring_heap->owner->rp_ent = NULL;
+		Mem_Free( r_ring_heap );
+		r_ring_heap = next;
+	}
+	// remade from GL_Bind's image when a rasteriser asks (R_SkinPix)
+	r_affinetridesc.pskin = NULL;
+}
+
+void R_TexRingStats( char *out, size_t len, qboolean reset )
+{
+	Q_snprintf( out, len, "R335: textures %u as 8-bit and palette (%u KiB, %u KiB saved), %u as 16-bit (%u KiB), %u differing from the old way; the ring %u KiB: %u rebuilt (%u KiB), %u dropped, %u to the heap (%u KiB)",
+		r_ring_count.pal, r_ring_count.pal_b >> 10, r_ring_count.saved_b >> 10, r_ring_count.full, r_ring_count.full_b >> 10, r_ring_count.bad,
+		r_ring_size >> 10, r_ring_count.decodes, r_ring_count.bytes >> 10, r_ring_count.evicts, r_ring_count.heap, r_ring_count.heap_bytes >> 10 );
+	if( reset )
+		r_ring_count.decodes = r_ring_count.bytes = r_ring_count.evicts = r_ring_count.heap = r_ring_count.heap_bytes = 0;
