+			rp_pre_t *p = RP_PreSlot( ent, 1 );
+			alight_t  a;
+
+			if( !p || p->stamp == rp_pre_stamp )
+				continue; /* no room, or listed twice: its draw works it out */
+			vec3_t    dir, spot, lvec;
+			colorVec  floor_was = ent->cvFloorColor;
+			uint32_t  mark = RP_PRE_MARK;
