+/*
+RetroPane (R306 after run 51): a light's float `die` against the frame's
+double time, `die < time`, made a software double compare and a widening
+(__aeabi_f2d ~1% of the play on the X51v, 61% of it from the models' light
+loops: 64 entity lights and 32 dynamic lights a model a frame). The time
+rounded up to a float once, `ceil_f`, gives exactly C's answer with float
+compares: a float below ceil_f is below the time (ceil_f is the least float
+at or above it), and one at or above it is not. The compare itself on the
+bits (NaN never less, -0 equal to +0).
+*/
+static inline float RP_TimeCeil( double t )
+{
+	float f = (float)t;
+
+	if((double)f < t )
+	{
+		/* the next float up, on the bits (f finite: t is a game time) */
+		uint32_t u;
+
+		__builtin_memcpy( &u, &f, sizeof( u ));
+		if(( u & 0x7FFFFFFFu ) == 0 )
+			u = 1; /* from either zero: the least positive float */
+		else if( u >> 31 )
+			u--;
+		else
+			u++;
+		__builtin_memcpy( &f, &u, sizeof( f ));
+	}
+	return f;
+}
+
+static inline qboolean RP_FloatLess( float a, float b )
+{
+	uint32_t ua, ub;
+
+	// kit 67: __builtin_memcpy between aligned locals is a register move;
+	// memcpy is a call in this freestanding build (run 64: 130 samples)
+	__builtin_memcpy( &ua, &a, sizeof( ua ));
+	__builtin_memcpy( &ub, &b, sizeof( ub ));
+	if(( ua & 0x7FFFFFFFu ) > 0x7F800000u || ( ub & 0x7FFFFFFFu ) > 0x7F800000u )
+		return false;
+	if((( ua | ub ) & 0x7FFFFFFFu ) == 0 )
+		return false;
+	ua = ( ua >> 31 ) ? ~ua : ua | 0x80000000u;
+	ub = ( ub >> 31 ) ? ~ub : ub | 0x80000000u;
+	return ua < ub;
+}
+
