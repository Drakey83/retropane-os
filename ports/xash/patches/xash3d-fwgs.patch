+/*
+Kit 84 (R324, run 83: R_TransEntityCompare and its floats ~1.5% of the
+cascade's heavy half, ~100 see-through debris pieces sorted a frame, two
+distances worked out in floats at every comparison). Iterate (rule 0):
+Xash's comparator measures both entities each time it is called (n log n
+distances); ours measures each entity once, by the comparator's own rules
+(its quirk kept: the second entity's test reads the first's model), and
+sorts those keys with the same qsort and the same comparison outcomes,
+so the same order.
+*/
+typedef struct
+{
+	cl_entity_t *ent;
+	float        dist1, dist2; /* as the first argument, as the second */
+	int          rank;
+} rp_tkey_t;
+
+static int RP_TransKeyCompare( const rp_tkey_t *a, const rp_tkey_t *b )
+{
+	if( a->dist1 > b->dist2 )
+		return -1;
+	if( a->dist1 < b->dist2 )
+		return 1;
+	if( a->rank > b->rank )
+		return 1;
+	if( a->rank < b->rank )
+		return -1;
+	return 0;
+}
+
+/* 0 if it cannot (more than it holds, or an entity with no model) */
+static int RP_SortTrans( void )
+{
+	enum { RP_TKEYS = 1024 };
+	static rp_tkey_t keys[RP_TKEYS];
+	int              n = tr.draw_list->num_trans_entities;
+
+	if( n > RP_TKEYS )
+		return 0;
+	for( int i = 0; i < n; i++ )
+	{
+		cl_entity_t *e = tr.draw_list->trans_entities[i];
+		int          rm;
+
+		if( !e->model )
+			return 0;
+		rm = R_GetEntityRenderMode( e );
+		keys[i].ent = e;
+		keys[i].rank = R_RankForRenderMode( rm );
+		/* every model is set, so both of the comparator's tests read alike */
+		if( e->model->type != mod_brush || rm != kRenderTransAlpha )
+		{
+			vec3_t org, vecLen;
+
+			VectorAverage( e->model->mins, e->model->maxs, org );
+			VectorAdd( e->origin, org, org );
+			VectorSubtract( RI.rvp.vieworigin, org, vecLen );
+			keys[i].dist1 = keys[i].dist2 = DotProduct( vecLen, vecLen );
+		}
+		else
+			keys[i].dist1 = keys[i].dist2 = 1000000000;
+	}
+	qsort( keys, n, sizeof( keys[0] ), (void *)RP_TransKeyCompare );
+	for( int i = 0; i < n; i++ )
+		tr.draw_list->trans_entities[i] = keys[i].ent;
+	return 1;
+}
