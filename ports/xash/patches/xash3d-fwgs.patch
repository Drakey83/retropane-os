+/*
+RetroPane (R335): each pool of 256 KiB or more summed by the source line
+that asked for its blocks (the ten biggest lines, the compact small blocks
+as one line): where a map's memory goes when most of it is small blocks.
+*/
+static void RP_MemSum_f( void )
+{
+	enum { RP_SITES = 128 };
+	static struct
+	{
+		const char *file;
+		int         line, count;
+		size_t      bytes;
+	} site[RP_SITES];
+
+	for( size_t i = 0; i < poolcount; i++ )
+	{
+		mempool_t *pool = &poolchain[i];
+		size_t     small = 0, smalln = 0;
+		int        n = 0, other = 0;
+
+		if( !pool->filename || pool->totalsize < 256 * 1024 )
+			continue;
+		for( memheader_t *mem = pool->chain; mem; mem = mem->next )
+		{
+			int k;
+
+			for( k = 0; k < n; k++ )
+				if( site[k].file == mem->filename && site[k].line == mem->fileline )
+					break;
+			if( k == n )
+			{
+				if( n == RP_SITES )
+				{
+					other++;
+					continue;
+				}
+				site[n].file = mem->filename;
+				site[n].line = mem->fileline;
+				site[n].count = 0;
+				site[n].bytes = 0;
+				n++;
+			}
+			site[k].count++;
+			site[k].bytes += mem->size;
+		}
+		for( memheader_small_t *mem = pool->chain_small; mem; mem = mem->next )
+		{
+			small += mem->size;
+			smalln++;
+		}
+		Con_Printf( "rp-memsum: %s %s in %d lines\n", pool->name, Q_memprint( pool->totalsize ), n );
+		for( int shown = 0; shown < 10; shown++ )
+		{
+			int best = -1;
+
+			for( int k = 0; k < n; k++ )
+				if( site[k].count > 0 && ( best < 0 || site[k].bytes > site[best].bytes ))
+					best = k;
+			if( best < 0 )
+				break;
+			Con_Printf( "rp-memsum:   %10s in %5d blocks at %s:%d\n", Q_memprint( site[best].bytes ), site[best].count, site[best].file, site[best].line );
+			site[best].count = 0;
+		}
+		if( smalln )
+			Con_Printf( "rp-memsum:   %10s in %5u small blocks\n", Q_memprint( small ), (unsigned)smalln );
+		if( other )
+			Con_Printf( "rp-memsum:   %d blocks past the %d lines kept\n", other, RP_SITES );
+	}
+}
