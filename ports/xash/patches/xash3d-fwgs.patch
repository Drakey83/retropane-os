+/* f >= 0.0f */
+static inline qboolean RP_Ge0( float f )
+{
+	uint32_t u = RP_FloatBits( f );
+
+	return (int32_t)u >= 0 ? u <= 0x7F800000u : u == 0x80000000u;
+}
+
+/* f < 0.0f */
+static inline qboolean RP_Lt0( float f )
+{
+	uint32_t u = RP_FloatBits( f );
+
+	return (int32_t)u < 0 && u != 0x80000000u && u <= 0xFF800000u;
+}
