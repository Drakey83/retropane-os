+/*
+===============
+RP_StudioMesh
+
+ref_rp step 4a (RetroPane, ports/xash/ref_rp/r_emit.c): the mesh's stored
+commands to the 2700G, each one strip or fan, lit as R_StudioSetColorBegin
+lights them; 0 when the mesh is not drawn there
+===============
+*/
+static void RP_StudioMesh( short *ptricmds, vec3_t *pstudionorms, qboolean half, qboolean chrome )
+{
+	static rp_svert_t v[RP_STUDIO_CMD];
+	// each normal's colour once a part when no local light is on (step 4b),
+	// or made in integers by R_StudioDrawPoints (4d's rest: rp_lit_part)
+	static byte       ncol[RP_STUDIO_VERTS][3];
+	static int        nser[RP_STUDIO_VERTS];
+	int               i, n, w = r_affinetridesc.skinwidth, h = r_affinetridesc.skinheight;
+	int               serial = RP_StudioSerial( );
+
+	if( !RP_StudioSkin( ))
+		return;
+	while(( i = *( ptricmds++ )))
+	{
+		n = i < 0 ? -i : i;
+		if( n > RP_STUDIO_CMD )
+		{
+			RP_StudioCmd( i < 0, n, NULL );
+			ptricmds += 4 * n;
+			continue;
+		}
+		for( int k = 0; k < n; k++, ptricmds += 4 )
+		{
+			int    ni = ptricmds[1];
+			rgba_t color;
+
+			if( rp_lit_part && (unsigned)ni < RP_STUDIO_VERTS )
+			{
+				v[k].rgb[0] = rp_ncol[ni][0];
+				v[k].rgb[1] = rp_ncol[ni][1];
+				v[k].rgb[2] = rp_ncol[ni][2];
+			}
+			else if( !g_studio.numlocallights && (unsigned)ni < RP_STUDIO_VERTS )
+			{
+				if( nser[ni] != serial )
+				{
+					nser[ni] = serial;
+					R_LightLambert( g_studio.lightpos[ptricmds[0]], pstudionorms[ni],
+						(float *)g_studio.lightvalues[ni], ncol[ni] );
+				}
+				v[k].rgb[0] = ncol[ni][0];
+				v[k].rgb[1] = ncol[ni][1];
+				v[k].rgb[2] = ncol[ni][2];
+			}
+			else
+			{
+				R_LightLambert( g_studio.lightpos[ptricmds[0]], pstudionorms[ni],
+					(float *)g_studio.lightvalues[ni], color );
+				v[k].rgb[0] = color[0];
+				v[k].rgb[1] = color[1];
+				v[k].rgb[2] = color[2];
+			}
+			v[k].xyz = g_studio.verts[ptricmds[0]];
+			v[k].idx = ptricmds[0];
+			if( chrome )
+			{
+				// R_StudioDrawChromeMesh's texels: the normal's against the
+				// bone's chrome vectors (in integers when lit so)
+				if( rp_lit_part && (unsigned)ni < RP_STUDIO_VERTS )
+				{
+					v[k].s = rp_chrome_st[ni][0];
+					v[k].t = rp_chrome_st[ni][1];
+				}
+				else
+				{
+					v[k].s = (int)( g_studio.chrome[ni][0] * 32.0f );
+					v[k].t = (int)( g_studio.chrome[ni][1] * 32.0f );
+				}
+			}
+			else if( half )
+			{
+				v[k].s = (int)( HalfToFloat( ptricmds[2] ) * w * 32.0f );
+				v[k].t = (int)( HalfToFloat( ptricmds[3] ) * h * 32.0f );
+			}
+			else
+			{
+				v[k].s = ptricmds[2] << 5;
+				v[k].t = ptricmds[3] << 5;
+			}
+		}
+		RP_StudioCmd( i < 0, n, v );
+	}
+}
