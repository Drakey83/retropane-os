+		rp_dl_gen = rp_light_gen;
+		rp_dl_tbits = tb;
+		rp_dl_dbits = db;
+	}
+	else if( rp_light_check )
+	{
+		uint8_t fresh[MAX_DLIGHTS];
+		int     n = RP_DlScan( time_f, fresh );
