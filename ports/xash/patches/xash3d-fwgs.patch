+static inline int64_t RP_WalkPlane( const float *minmaxs, const int *pindex, int i )
+{
+	return (int64_t)rp_wn.n[i][0] * rp_fixq( minmaxs[pindex[0]], 16 )
+		+ (int64_t)rp_wn.n[i][1] * rp_fixq( minmaxs[pindex[1]], 16 )
+		+ (int64_t)rp_wn.n[i][2] * rp_fixq( minmaxs[pindex[2]], 16 )
