+		}
+		else if( memcmp( lm[ti], v, sizeof( v )))
+			ok = 0;
+	}
+	free( seen );
+	if( ok )
+		rp_ln.lm = lm;
+	else
+		free( lm );
+}
+
+/* the light nodes for this model's nodes, or NULL (the float-bit walk) */
+static const rp_lnode_t *RP_LnFor( const model_t *m )
+{
+	if( !rp_ln.made || m->nodes != rp_ln.nodes )
+	{
+		const model_t *w = gp_cl->models[1];
+
+		if( !w || w->nodes != m->nodes )
+			return NULL; /* not the world's arrays */
+		RP_LnMake( w );
+	}
+	return rp_ln.ln;
+}
+
+static inline int32_t RP_LnPlane( const rp_lnode_t *nd, const int32_t p[3] )
+{
+	/* RP_LPlane's sums on the same numbers */
+	if( nd->n[0] < -0x60000000 )
+		return p[(uint32_t)nd->n[0] & 3u] - nd->d;
+	return (int32_t)(( (int64_t)p[0] * nd->n[0] + (int64_t)p[1] * nd->n[1] + (int64_t)p[2] * nd->n[2] ) >> 30 ) - nd->d;
+}
+
+/* one surface tried at the crossing point: 1 hit, -1 a deluxemap, 0 not it */
+static inline int RP_LightSurfFix( const msurface_t *surf, const int32_t (*lv)[4], const int32_t mid[3], int32_t midf, colorVec *cv )
+{
+	const mextrasurf_t *info = surf->info;
+
+	if( FBitSet( surf->flags, SURF_DRAWTILED ))
+		return 0; // no lightmaps
+
+	int32_t st[2];
+
+	if( lv )
+	{
+		for( int a = 0; a < 2; a++ )
+			st[a] = (int32_t)(( (int64_t)mid[0] * lv[a][0] + (int64_t)mid[1] * lv[a][1]
+				+ (int64_t)mid[2] * lv[a][2] ) >> 16 ) + lv[a][3];
+	}
+	else
+	{
+		for( int a = 0; a < 2; a++ )
+			st[a] = (int32_t)(( (int64_t)mid[0] * RP_LFix( info->lmvecs[a][0], 16 ) + (int64_t)mid[1] * RP_LFix( info->lmvecs[a][1], 16 )
+				+ (int64_t)mid[2] * RP_LFix( info->lmvecs[a][2], 16 )) >> 16 ) + RP_LFix( info->lmvecs[a][3], 16 );
+	}
+
+	if( st[0] < ( info->lightmapmins[0] << 16 ) || st[1] < ( info->lightmapmins[1] << 16 ))
+		return 0;
+
+	int32_t ds = st[0] - ( info->lightmapmins[0] << 16 );
+	int32_t dt = st[1] - ( info->lightmapmins[1] << 16 );
+
+	if( ds > ( info->lightextents[0] << 16 ) || dt > ( info->lightextents[1] << 16 ))
+		return 0;
+
+	if( surf->info->deluxemap )
+		return -1;
+
+	cv->r = cv->g = cv->b = cv->a = 0;
+	for( int k = 0; k < 3; k++ )
+		g_trace_lightspot[k] = mid[k] * ( 1.0f / 65536.0f );
+
+	if( !surf->samples )
+		return 1;
+
+	int sample_size = gEngfuncs.Mod_SampleSizeForFace( surf );
+	int smax = ( info->lightextents[0] / sample_size ) + 1;
+	int tmax = ( info->lightextents[1] / sample_size ) + 1;
+	/* Q_rint( ds / sample_size ): to the nearest, halves away from 0 (ds >= 0 here) */
+	int is = ( ds / sample_size + 0x8000 ) >> 16;
+	int it = ( dt / sample_size + 0x8000 ) >> 16;
+
+	g_trace_fraction = midf * ( 1.0f / 65536.0f );
+
+	const color24 *lm = surf->samples + it * smax + is;
+	int            size = smax * tmax;
+
+	for( int map = 0; map < MAXLIGHTMAPS && surf->styles[map] != 255; map++ )
+	{
+		uint scale = g_lightstylevalue[surf->styles[map]];
+
+		cv->r += lm->r * scale;
+		cv->g += lm->g * scale;
+		cv->b += lm->b * scale;
+		lm += size; // skip to next lightmap
+	}
+	return 1;
+}
+
+/* RP_LightPointFix on the light nodes: the same walk, node by number */
+static int RP_LightPointLn( const model_t *model, const rp_lnode_t *ln, int ni, int32_t p1f, int32_t p2f, colorVec *cv, const int32_t start[3], const int32_t end[3] )
+{
+start:
+	if( ni < 0 )
+	{
+		cv->r = cv->g = cv->b = cv->a = 0;
+		return 0;
+	}
+
+	const rp_lnode_t *nd = &ln[ni];
+	int32_t           front = RP_LnPlane( nd, start );
+	int32_t           back = RP_LnPlane( nd, end );
+	int               side = front < 0;
+
+	rp_ln_counts[0]++;
+	if(( back < 0 ) == side )
+	{
+		ni = nd->child[side];
+		goto start;
+	}
+
+	/* frac = front / ( front - back ), 16.16, in [0, 1] (the signs differ) */
+	int32_t frac = (int32_t)(( (int64_t)front << 16 ) / ( (int64_t)front - back ));
+	int32_t mid[3];
+
+	for( int k = 0; k < 3; k++ )
+		mid[k] = start[k] + (int32_t)(( (int64_t)( end[k] - start[k] ) * frac ) >> 16 );
+
+	int32_t midf = p1f + (int32_t)(( (int64_t)( p2f - p1f ) * frac ) >> 16 );
+	int     r = RP_LightPointLn( model, ln, nd->child[side], p1f, midf, cv, start, mid );
+
+	if( r )
+		return r;
+
+	const msurface_t *surf = &model->surfaces[nd->firstsurf];
+
+	for( int i = 0; i < nd->numsurf; i++, surf++ )
+	{
+		rp_ln_counts[1]++;
+		r = RP_LightSurfFix( surf, rp_ln.lm ? rp_ln.lm[surf->texinfo - model->texinfo] : NULL, mid, midf, cv );
+		if( r )
+			return r;
+	}
+
+	// go down back side
+	return RP_LightPointLn( model, ln, nd->child[!side], midf, p2f, cv, mid, end );
+}
+
+/* As R_RecursiveLightPoint: 1 hit, 0 nothing, -1 a deluxemap (the float walk's) */
+static int RP_LightPointFix( model_t *model, mnode_t *node, int32_t p1f, int32_t p2f, colorVec *cv, const int32_t start[3], const int32_t end[3] )
+{
+start:
+	if( !node || node->contents < 0 )
+	{
+		cv->r = cv->g = cv->b = cv->a = 0;
+		return 0;
+	}
+
+	int32_t front = RP_LPlane( node->plane, start );
+	int32_t back = RP_LPlane( node->plane, end );
+	int     side = front < 0;
+
+	if(( back < 0 ) == side )
+	{
+		node = node_child( node, side, model );
+		goto start;
+	}
+
+	/* frac = front / ( front - back ), 16.16, in [0, 1] (the signs differ) */
+	int32_t frac = (int32_t)(( (int64_t)front << 16 ) / ( (int64_t)front - back ));
+	int32_t mid[3];
+
+	for( int k = 0; k < 3; k++ )
+		mid[k] = start[k] + (int32_t)(( (int64_t)( end[k] - start[k] ) * frac ) >> 16 );
+
+	int32_t midf = p1f + (int32_t)(( (int64_t)( p2f - p1f ) * frac ) >> 16 );
+	int     r = RP_LightPointFix( model, node_child( node, side, model ), p1f, midf, cv, start, mid );
+
+	if( r )
+		return r;
+
+	int firstsurface = node_firstsurface( node, model );
+	int numsurfaces = node_numsurfaces( node, model );
+
+	for( int i = 0; i < numsurfaces; i++ )
+	{
+		const msurface_t   *surf = &model->surfaces[firstsurface + i];
+		const mextrasurf_t *info = surf->info;
+
+		if( FBitSet( surf->flags, SURF_DRAWTILED ))
+			continue; // no lightmaps
+
+		int32_t st[2];
+
+		for( int a = 0; a < 2; a++ )
+			st[a] = (int32_t)(( (int64_t)mid[0] * RP_LFix( info->lmvecs[a][0], 16 ) + (int64_t)mid[1] * RP_LFix( info->lmvecs[a][1], 16 )
+				+ (int64_t)mid[2] * RP_LFix( info->lmvecs[a][2], 16 )) >> 16 ) + RP_LFix( info->lmvecs[a][3], 16 );
+
+		if( st[0] < ( info->lightmapmins[0] << 16 ) || st[1] < ( info->lightmapmins[1] << 16 ))
+			continue;
+
+		int32_t ds = st[0] - ( info->lightmapmins[0] << 16 );
+		int32_t dt = st[1] - ( info->lightmapmins[1] << 16 );
+
+		if( ds > ( info->lightextents[0] << 16 ) || dt > ( info->lightextents[1] << 16 ))
+			continue;
+
+		if( surf->info->deluxemap )
+			return -1;
+
+		cv->r = cv->g = cv->b = cv->a = 0;
+		for( int k = 0; k < 3; k++ )
+			g_trace_lightspot[k] = mid[k] * ( 1.0f / 65536.0f );
+
+		if( !surf->samples )
+			return 1;
+
+		int sample_size = gEngfuncs.Mod_SampleSizeForFace( surf );
+		int smax = ( info->lightextents[0] / sample_size ) + 1;
+		int tmax = ( info->lightextents[1] / sample_size ) + 1;
+		/* Q_rint( ds / sample_size ): to the nearest, halves away from 0 (ds >= 0 here) */
+		int is = ( ds / sample_size + 0x8000 ) >> 16;
+		int it = ( dt / sample_size + 0x8000 ) >> 16;
+
+		g_trace_fraction = midf * ( 1.0f / 65536.0f );
+
+		const color24 *lm = surf->samples + it * smax + is;
+		int            size = smax * tmax;
+
+		for( int map = 0; map < MAXLIGHTMAPS && surf->styles[map] != 255; map++ )
+		{
+			uint scale = g_lightstylevalue[surf->styles[map]];
+
+			cv->r += lm->r * scale;
+			cv->g += lm->g * scale;
+			cv->b += lm->b * scale;
+			lm += size; // skip to next lightmap
+		}
+		return 1;
+	}
+
+	// go down back side
+	return RP_LightPointFix( model, node_child( node, !side, model ), midf, p2f, cv, mid, end );
+}
+#endif
