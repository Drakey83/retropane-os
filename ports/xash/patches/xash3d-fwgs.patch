+
+/* the point in 16.16 when every |coordinate| < 32768 (exponent < 142), else 0 */
+static __attribute__(( noinline )) int RP_TracePoint( const float *p, int32_t q[3] )
+{
+	uint32_t u[3];
+
+	__builtin_memcpy( u, p, sizeof( u ));
+	__asm__( "" : "+r"( u[0] ), "+r"( u[1] ), "+r"( u[2] ));
+	for( int j = 0; j < 3; j++ )
+	{
+		uint32_t e = u[j] >> 23 & 0xFF;
+		int      sh = (int)e - 127 - 23 + 16;
+		uint32_t m;
+		int32_t  v;
+
+		if( e >= 142 )
+			return 0;
+		if( e == 0 || sh < -24 )
+		{
+			q[j] = 0; /* |p| < 2^-16: 0, within the margin */
+			continue;
+		}
+		m = ( u[j] & 0x007FFFFFu ) | 0x00800000u;
+		v = (int32_t)( sh >= 0 ? m << sh : m >> -sh );
+		q[j] = u[j] >> 31 ? -v : v;
+	}
+	return 1;
+}
+
+/* the side of node num's plane for a point in 16.16: 0 front (lhs >= dist),
+   1 back, -1 the integers can't say (the float code decides) */
+#define RP_TRACE_MARGIN ( (int64_t)1 << 41 ) /* 1/32 unit in 2^46 */
+static __attribute__(( noinline )) int RP_TraceSide( int num, const int32_t q[3] )
+{
+	uint32_t           np;
+	const rp_tplane_t *pl;
+	int64_t            v;
+
+	if( (unsigned)num >= (unsigned)rp_trace_nnodes || ( np = rp_trace_np[num] ) == 0xFFFFu )
+		return -1;
+	pl = &rp_trace_pl[np];
+	v = (int64_t)q[0] * pl->n[0] + (int64_t)q[1] * pl->n[1] + (int64_t)q[2] * pl->n[2] - ( (int64_t)pl->d << 30 );
+	if( v >= RP_TRACE_MARGIN )
+		return 0;
+	if( v <= -RP_TRACE_MARGIN )
+		return 1;
+	return -1;
+}
+
+/* PlaneDiff( p, plane ) < 0, the subtraction only when the compare can't say */
+static inline int RP_PlaneBack( const float *p, const mplane_t *plane )
+{
+	float lhs = RP_PlaneLhs( p, plane );
+	int   side = RP_LtSide( lhs, plane->dist );
+
+	return side >= 0 ? side : RP_Lt0( lhs - plane->dist );
+}
