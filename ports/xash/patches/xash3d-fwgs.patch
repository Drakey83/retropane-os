+		&& !memcmp( &p->time, &time, sizeof( time ))
+		&& !memcmp( &p->fullbright, &r_fullbright->value, sizeof( float ))
+		&& !memcmp( &p->dynamic, &r_dynamic->value, sizeof( float ))
+		&& !memcmp( &p->direct, &v_direct->value, sizeof( float ))
+		&& p->key == RP_LightKey( )
+		&& RP_PreDlSame( time );
+}
