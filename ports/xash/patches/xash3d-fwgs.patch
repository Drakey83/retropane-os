+static uint32_t rp_el_tbits;
+static const dlight_t *rp_el_table;
+
+static __attribute__(( noinline )) int RP_ElScan( float time_f, uint8_t *out )
+{
+	int n = 0;
+
+	for( int lnum = 0; lnum < MAX_ELIGHTS; lnum++ )
+	{
+		const dlight_t *el = &tr.elights[lnum];
+
+		if( lnum + 4 < MAX_ELIGHTS )
+			__builtin_prefetch( &tr.elights[lnum + 4].die );
+		if( !( RP_FloatLess( el->die, time_f ) || el->radius <= 0.0f ))
+			out[n++] = (uint8_t)lnum;
+	}
+	return n;
+}
+
+static int RP_ElLive( float time_f, const uint8_t **live )
+{
+	uint32_t tb;
+
+	memcpy( &tb, &time_f, 4 );
+	if( rp_el_gen != rp_light_gen || tb != rp_el_tbits || rp_el_table != tr.elights )
+	{
+		rp_el_n = RP_ElScan( time_f, rp_el_live );
+		rp_el_gen = rp_light_gen;
+		rp_el_tbits = tb;
+		rp_el_table = tr.elights;
+	}
+	else if( rp_light_check > 0 )
+	{
+		uint8_t fresh[MAX_ELIGHTS];
+		int     n = RP_ElScan( time_f, fresh );
+
+		rp_light_checks[0]++;
+		rp_light_checks[1] += n != rp_el_n || memcmp( fresh, rp_el_live, n );
+	}
+	*live = rp_el_live;
+	return rp_el_n;
+}
