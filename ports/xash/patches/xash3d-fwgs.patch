+void R_EntityDynamicLight( cl_entity_t *ent, alight_t *plight, qboolean draw_world, double time, vec3_t lightspot, vec3_t lightvec );
+
+/*
+`-rpdebrisplainN` (r_main.c RP_DebrisCap): a far debris piece takes the
+light of its 64-unit cell, sampled once a frame by the cell's first far
+piece the game's way (R_EntityDynamicLight on that piece). Vendor: every
+model sampled at its own origin every frame (GoldSrc, Xash). Modern: light
+probes (Quake 3's baked grid, today's irradiance volumes), shared by
+everything near them. Ours: probes made lazily only where far pieces are,
+this frame only, so a moving light or a style change is never stale; the
+near pieces keep the game's own sample.
+*/
+#define RP_PROBES 64
+typedef struct
+{
+	unsigned stamp;
+	int      cell[3];
+	qboolean draw_world;
+	int      ambientlight, shadelight;
+	vec3_t   color, vec, spot, lvec;
+	colorVec floor;
+} rp_probe_t;
+static rp_probe_t rp_probe[RP_PROBES];
+static int        rp_probe_inside;
+unsigned          rp_probe_counts[2]; /* far pieces lit, probes sampled */
+
+static __attribute__(( noinline )) void RP_ProbeLight( cl_entity_t *ent, alight_t *plight, qboolean draw_world, double time, vec3_t lightspot, vec3_t lightvec )
+{
+	extern unsigned rp_far_stamp;
+	int      c[3];
+	unsigned h;
+
+	for( int k = 0; k < 3; k++ )
+		c[k] = (int)( ent->origin[k] + 65536.0f ) >> 6;
+	h = ((unsigned)c[0] * 73856093u ^ (unsigned)c[1] * 19349663u ^ (unsigned)c[2] * 83492791u ) % RP_PROBES;
+	rp_probe_counts[0]++;
+	for( int k = 0; k < 8; k++, h = ( h + 1 ) % RP_PROBES )
+	{
+		rp_probe_t *p = &rp_probe[h];
+
+		if( p->stamp == rp_far_stamp )
+		{
+			if( p->cell[0] != c[0] || p->cell[1] != c[1] || p->cell[2] != c[2] || p->draw_world != !!draw_world )
+				continue;
+			plight->ambientlight = p->ambientlight;
+			plight->shadelight = p->shadelight;
+			VectorCopy( p->color, plight->color );
+			if( plight->plightvec )
+				VectorCopy( p->vec, plight->plightvec );
+			ent->cvFloorColor = p->floor;
+			VectorCopy( p->spot, lightspot );
+			VectorCopy( p->lvec, lightvec );
+			return;
+		}
+		/* an empty slot: this piece samples the cell */
+		rp_probe_counts[1]++;
+		rp_probe_inside = 1;
+		R_EntityDynamicLight( ent, plight, draw_world, time, lightspot, lightvec );
+		rp_probe_inside = 0;
+		p->stamp = rp_far_stamp;
+		VectorCopy( c, p->cell );
+		p->draw_world = !!draw_world;
+		p->ambientlight = plight->ambientlight;
+		p->shadelight = plight->shadelight;
+		VectorCopy( plight->color, p->color );
+		if( plight->plightvec )
+			VectorCopy( plight->plightvec, p->vec );
+		else
+			VectorSet( p->vec, 0.0f, 0.0f, -1.0f );
+		p->floor = ent->cvFloorColor;
+		VectorCopy( lightspot, p->spot );
+		VectorCopy( lightvec, p->lvec );
+		return;
+	}
+	/* eight cells collide: the piece samples itself */
+	rp_probe_counts[1]++;
+	rp_probe_inside = 1;
+	R_EntityDynamicLight( ent, plight, draw_world, time, lightspot, lightvec );
+	rp_probe_inside = 0;
+}
+
+/* the lighting stage: every studio model of the draw list, once */
+void RP_LightPrepass( const cl_entity_t *const *lists[2], const uint counts[2], qboolean draw_world, double time )
+{
+	if( rp_pre_off < 0 )
+		rp_pre_off = !!gEngfuncs.Sys_CheckParm( "-rpnopre" );
+	rp_pre_live = 0;
+	if( rp_pre_off )
+		return;
+	rp_pre_stamp++;
+	memcpy( rp_pre_dl, gp_dlights, sizeof( rp_pre_dl ));
+	rp_pre_gen = rp_light_gen; // kit 107: the copy is the table while this holds
+	rp_pre_filling = 1;
+	for( int l = 0; l < 2; l++ )
+	{
+		for( uint i = 0; i < counts[l]; i++ )
+		{
+			cl_entity_t *ent = (cl_entity_t *)lists[l][i];
+
+			if( !ent || !ent->model || ent->model->type != mod_studio )
+				continue;
+			if( RP_DebrisFar( ent ))
+				continue; /* drawn plainly: its cell's sample, made at its draw */
+
+			rp_pre_t *p = RP_PreSlot( ent, 1 );
+			alight_t  a;
+
+			if( !p || p->stamp == rp_pre_stamp )
+				continue; /* no room, or listed twice: its draw works it out */
+			vec3_t    dir, spot, lvec;
+			colorVec  floor_was = ent->cvFloorColor;
+			uint32_t  mark = RP_PRE_MARK;
+
+			for( int k = 0; k < 3; k++ )
+			{
+				memcpy( &spot[k], &mark, 4 );
+				memcpy( &lvec[k], &mark, 4 );
+			}
+			memset( &a, 0, sizeof( a ));
+			a.plightvec = dir;
+			R_EntityDynamicLight( ent, &a, draw_world, time, spot, lvec );
+
+			p->ent = ent;
+			p->model = ent->model;
+			p->stamp = rp_pre_stamp;
+			memcpy( p->org, ent->origin, sizeof( p->org ));
+			p->effects = ent->curstate.effects;
+			p->renderfx = ent->curstate.renderfx;
+			p->iuser4 = ent->curstate.iuser4;
+			p->draw_world = !!draw_world;
+			p->time = time;
+			p->key = RP_LightKey( );
+			p->fullbright = r_fullbright->value;
+			p->dynamic = r_dynamic->value;
+			p->direct = v_direct->value;
+			p->ambientlight = a.ambientlight;
+			p->shadelight = a.shadelight;
+			VectorCopy( a.color, p->color );
+			VectorCopy( dir, p->vec );
+			p->floor = ent->cvFloorColor;
+			ent->cvFloorColor = floor_was; /* written when its draw asks */
+			p->wrote = 0;
+			for( int k = 0; k < 3; k++ )
+			{
+				uint32_t u;
+
+				memcpy( &u, &spot[k], 4 );
+				if( u != RP_PRE_MARK )
+					p->wrote |= 1u << k;
+				memcpy( &u, &lvec[k], 4 );
+				if( u != RP_PRE_MARK )
+					p->wrote |= 8u << k;
+			}
+			VectorCopy( spot, p->spot );
+			VectorCopy( lvec, p->lvec );
+		}
+	}
+	rp_pre_filling = 0;
+	rp_pre_live = 1;
+}
