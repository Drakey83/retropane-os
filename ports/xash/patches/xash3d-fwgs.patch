+/*
+ref_rp (RetroPane, R306 after run 51): an entity's floor light kept. The
+light under a model is sampled anew every frame (R_LightVec walks every
+brush model's tree, up to five times for the gradient, and a line to the
+sky first): R_RecursiveLightPoint, R_LightVecInternal, R_EntityDynamicLight
+and their floats were ~3.5% of the play on the X51v, mostly for models that
+had not moved. GL's and the software renderer's way is to sample again;
+ours keeps the sample per entity and takes it again only when something
+it reads changed: the entity's origin, model and light effects (exactly,
+as bits), or the frame's light key (every light style's value, the sky's
+colour and vector, the world, and each brush model's place and angles,
+hashed in 64 bits once a frame). The dynamic lights are still added every
+frame, so a muzzle flash or flare lights the model as before; the result
+is the same as sampling again.
+*/
+typedef struct
+{
+	const cl_entity_t *ent;
+	const model_t     *model;
+	uint32_t          org[3];
+	int               effects;
+	uint64_t          key;
+	colorVec          light;
+	vec3_t            dir, spot, vec;
+	qboolean          sampled; /* lightspot and lightvec written */
+} rp_elight_t;
+
+#define RP_ELIGHTS 256
+static rp_elight_t rp_elight[RP_ELIGHTS];
+
+/*
+The owner's options A and B (2026-11-18, "Measure options A and B": the
+cascade's debris lighting ~7 ms of a heavy frame). Measured behind
+switches, off by default; they change the shading slightly, so they stay
+off until the owner rules on them.
+-rplighthalf (A): a model lit afresh last frame takes that frame's light
+this frame (its own slot, probed by entity), then is lit afresh again: each
+model lit every second frame. The dynamic lights are still added each frame.
+-rplightone (B): one light trace a model, not five: the four side traces
+that tilt the light's direction are not made (the light straight down).
+*/
+typedef struct
+{
+	const cl_entity_t *ent;
+	const model_t     *model;
+	uint64_t          key;
+	int               effects;
+	unsigned          frame, fresh;
+	colorVec          light;
+	vec3_t            dir, spot, vec;
+	qboolean          sampled;
+} rp_half_t;
+
+#define RP_HALF 1024
+static rp_half_t rp_half[RP_HALF];
+static unsigned  rp_half_frame;
+static double    rp_half_time = -1.0;
+static int       rp_light_half = -1, rp_light_one = -1;
+
+static rp_half_t *RP_HalfSlot( const cl_entity_t *ent )
+{
+	uint32_t   h = (uint32_t)(uintptr_t)ent * 2654435761u >> 22;
+	rp_half_t *old = NULL;
+
+	for( int k = 0; k < 8; k++ )
+	{
+		rp_half_t *p = &rp_half[( h + k ) & ( RP_HALF - 1 )];
+
+		if( p->ent == ent )
+			return p;
+		if( !old && p->frame + 2 <= rp_half_frame )
+			old = p;
+	}
+	return old;
+}
+static uint64_t    rp_elight_key;
+static double      rp_elight_time = -1.0;
+
+static uint64_t RP_Fnv( uint64_t h, const void *p, size_t n )
+{
+	const byte *b = p;
+
+	for( size_t i = 0; i < n; i++ )
+		h = ( h ^ b[i] ) * 0x100000001B3ULL;
+	return h;
+}
+
+static uint64_t RP_LightKey( void )
+{
+	uint64_t h = 0xCBF29CE484222325ULL;
+
+	if( rp_elight_time == gp_cl->time )
+		return rp_elight_key;
+	rp_elight_time = gp_cl->time;
+	h = RP_Fnv( h, g_lightstylevalue, sizeof( g_lightstylevalue ));
+	h = RP_Fnv( h, gp_movevars->skycolor, sizeof( gp_movevars->skycolor ));
+	h = RP_Fnv( h, gp_movevars->skyvec, sizeof( gp_movevars->skyvec ));
+	h = RP_Fnv( h, &gp_cl->models[1], sizeof( gp_cl->models[1] ));
+	h = RP_Fnv( h, &r_lighting_extended.value, sizeof( r_lighting_extended.value ));
+	for( int i = 0; i < MAX_PHYSENTS; i++ )
+	{
+		const physent_t *pe = gEngfuncs.EV_GetPhysent( i );
+
+		if( !pe )
+			break;
+		if( !pe->model || pe->model->type != mod_brush )
+			continue;
+		h = RP_Fnv( h, &pe->model, sizeof( pe->model ));
+		h = RP_Fnv( h, pe->origin, sizeof( pe->origin ));
+		h = RP_Fnv( h, pe->angles, sizeof( pe->angles ));
+	}
+	rp_elight_key = h;
+	return h;
+}
