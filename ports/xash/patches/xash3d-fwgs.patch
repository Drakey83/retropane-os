+#if defined( __retropane__ )
+/*
+Kit 79 (R324, the emulator's cascade: the light probes ~10% of a frame,
+each moving model five floor traces a frame, every node a float plane
+test, a float divide and lerp, every surface two float dot products).
+Iterate (rule 0): GoldSrc, Quake and Xash trace the light ray down the BSP
+in floats; ours walks the same nodes in the same order in 16.16 integers,
+each plane's numbers read from their float bits as they are met (no table,
+no memory), the crossing point by one integer divide, the luxel picked
+from the same lightmap vectors in 16.16. The same nodes and surfaces; the
+luxel within one at a boundary (the float rounding). Deluxemaps (none in
+Half-Life's maps) keep the float walk; -rplightfloat keeps it for all.
+*/
+static inline int32_t RP_LFix( float f, int q )
+{
+	/* f x 2^q from the float's bits (no software float call) */
+	uint32_t u, m;
+	int      e, v;
+
+	__builtin_memcpy( &u, &f, sizeof( u ));
+	__asm__( "" : "+r"( u ));
+	e = (int)( u >> 23 & 0xFF ) - 127 + q; /* the exponent of f x 2^q */
+	if( e < 0 )
+		return 0;
+	if( e > 30 )
+		return u >> 31 ? -0x7FFFFFFF : 0x7FFFFFFF;
+	m = ( u & 0x007FFFFFu ) | 0x00800000u;
+	v = (int)( e >= 23 ? m << ( e - 23 ) : m >> ( 23 - e ));
+	return u >> 31 ? -v : v;
+}
+
+/* the point's distance from the plane, 16.16 */
+static inline int32_t RP_LPlane( const mplane_t *pl, const int32_t p[3] )
+{
+	int32_t d = RP_LFix( pl->dist, 16 );
+
+	if( pl->type < 3 )
+		return p[pl->type] - d;
+	return (int32_t)(( (int64_t)p[0] * RP_LFix( pl->normal[0], 30 ) + (int64_t)p[1] * RP_LFix( pl->normal[1], 30 )
+		+ (int64_t)p[2] * RP_LFix( pl->normal[2], 30 )) >> 30 ) - d;
+}
