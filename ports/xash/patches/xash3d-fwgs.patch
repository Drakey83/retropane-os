+/* Level `j` (`width` x `height`) of the RGBA `data` into `out` as pixel_t,
+   and the alpha copy into `aout` at level 0: the upload's own loop. */
+static void R_TexLevel( const image_t *tex, const byte *data, int j, uint width, uint height, pixel_t *out, pixel_t *aout )
+{
+	const int onebit = FBitSet( tex->rp_bits, RP_TB_ONEBIT ) != 0;
+	const int noalpha = FBitSet( tex->rp_bits, RP_TB_NOALPHA ) != 0;
+	const int hasalpha = FBitSet( tex->rp_bits, RP_TB_ALPHA ) != 0;
+
+	for( uint i = 0; i < height * width; i++ )
+	{
+		unsigned int r, g, b, major, minor;
+		// seems to look better
+		r = data[i * 4 + 0] * BIT( 5 ) / 256;
+		g = data[i * 4 + 1] * BIT( 6 ) / 256;
+		b = data[i * 4 + 2] * BIT( 5 ) / 256;
+
+		// 565 to 332
+		major = ((( r >> 2 ) & MASK( 3 )) << 5 ) | (((( g >> 3 ) & MASK( 3 )) << 2 )) | ((( b >> 3 ) & MASK( 2 )));
+
+		// save minor GBRGBRGB
+		minor = MOVE_BIT( r, 1, 5 ) | MOVE_BIT( r, 0, 2 ) | MOVE_BIT( g, 2, 7 ) | MOVE_BIT( g, 1, 4 ) | MOVE_BIT( g, 0, 1 ) | MOVE_BIT( b, 2, 6 ) | MOVE_BIT( b, 1, 3 ) | MOVE_BIT( b, 0, 0 );
+
+		out[i] = major << 8 | ( minor & 0xFF );
+		if( j == 0 && aout )
+		{
+			unsigned int alpha = ( data[i * 4 + 3] * 8 / 256 ) << ( 16 - 3 );
+			aout[i] = ( out[i] >> 3 ) | alpha;
+			if( !noalpha && data[i * 4 + 3] < 128 && onebit )
+				out[i] = TRANSPARENT_COLOR;         // 0000 0011 0100 1001;
+		}
+		// RetroPane (kit 75, R321: c1a0e's ladder drawn as a black strip):
+		// the coarser levels keep the see-through key too, by the same
+		// rule on their averaged alpha (only mip 0 had it, so a '{' face
+		// drawn at mip 1-3 showed its holes black)
+		else if( j > 0 && hasalpha && !noalpha && data[i * 4 + 3] < 128 && onebit )
+			out[i] = TRANSPARENT_COLOR;
+	}
+}
+
+static void GL_BuildMipMap( byte *in, int srcWidth, int srcHeight, int srcDepth, int flags );
+
+/* A compact texture's levels `from` to `to` (and the alpha copy with level
+   0) built into a new ring block. Level 0 is the upload's conversion of
+   each texel on its own, so it is made once a colour (the palette through
+   R_TexLevel, 256 texels at most) and looked up a texel; the coarser levels
+   need the upload's mip chain: the colours expanded into the block's tail,
+   GL_BuildMipMap run on them as the upload ran it, the tail given back.
+   (Run 262: rebuilding all four levels for a skin or a picture, which
+   reads only level 0, cost the fight's first 250 frames ~0.4 ms each.) */
+static r_tent_t *R_TexDecode( image_t *tex, int from, int to )
+{
+	const uint w = tex->width, h = tex->height, n = w * h;
+	const int  alpha = from == 0 && FBitSet( tex->rp_bits, RP_TB_ALPHA );
+	uint32_t   off[4] = { 0 }, aoff = 0, lvbytes = 0;
+	r_tent_t   *b;
+	byte       *body;
+	uint64_t   t0 = rp_time_us( );
+
+	for( int j = from; j <= to; j++ )
+	{
+		off[j] = lvbytes;
+		lvbytes += ( Q_max( 1, w >> j ) * Q_max( 1, h >> j ) * 2u + 3u ) & ~3u;
+	}
+	if( alpha )
+	{
+		aoff = lvbytes;
+		lvbytes += ( n * 2u + 3u ) & ~3u;
+	}
+	b = R_RingAlloc( lvbytes + ( to > 0 ? n * 4u : 0u ));
+	body = (byte *)( b + 1 );
+	for( int j = from; j <= to; j++ )
+		b->lv[j] = (pixel_t *)( body + off[j] );
+	if( alpha )
+		b->alpha = (pixel_t *)( body + aoff );
+	if( from == 0 )
+	{
+		pixel_t c16[256], a16[256];
+		pixel_t *lv0 = b->lv[0];
+
+		R_TexLevel( tex, (const byte *)tex->rp_pal, 0, tex->rp_npal, 1, c16, alpha ? a16 : NULL );
+		for( uint i = 0; i < n; i++ )
+			lv0[i] = c16[tex->rp_idx[i]];
+		if( alpha )
+			for( uint i = 0; i < n; i++ )
+				b->alpha[i] = a16[tex->rp_idx[i]];
+	}
+	if( to > 0 )
+	{
+		uint32_t *rgba = (uint32_t *)( body + lvbytes );
+
+		for( uint i = 0; i < n; i++ )
+			rgba[i] = tex->rp_pal[tex->rp_idx[i]];
+		for( int j = 0; j < to; j++ )
+		{
+			GL_BuildMipMap( (byte *)rgba, Q_max( 1, w >> j ), Q_max( 1, h >> j ), tex->depth, tex->flags );
+			if( j + 1 >= from )
+				R_TexLevel( tex, (const byte *)rgba, j + 1, Q_max( 1, w >> ( j + 1 )), Q_max( 1, h >> ( j + 1 )), b->lv[j + 1], NULL );
+		}
+		R_RingShrink( b, lvbytes );
+	}
+	b->owner = tex;
+	b->from = (byte)from;
+	b->to = (byte)to;
+	tex->rp_ent = b;
+	r_ring_count.decodes++;
+	r_ring_count.bytes += lvbytes;
+	rp_tex_rebuilds++;
+	{
+		uint32_t us = (uint32_t)( rp_time_us( ) - t0 );
+
+		if( us > rp_tex_rebuild_us_max )
+			rp_tex_rebuild_us_max = us;
+	}
+	return b;
+}
+
+/* The block holding levels `from` to `to` of a compact texture, rebuilt
+   when gone (with the levels the old block held, so two readers at two
+   levels don't take turns); `transient`: read at once and let go (the
+   next block may take it). */
+static r_tent_t *R_TexEnt( image_t *tex, int from, int to, int transient )
+{
+	r_tent_t *b = (r_tent_t *)tex->rp_ent;
+
+	if( !b || b->from > from || b->to < to )
+	{
+		if( b )
+		{
+			from = Q_min( from, b->from );
+			to = Q_max( to, b->to );
+			if( b->heap )
+				b->owner = NULL;
+			else
+				R_TentDrop( b );
+			tex->rp_ent = NULL;
+			if( r_skin_img == tex )
+				r_affinetridesc.pskin = NULL; // it may have pointed into that block
+		}
+		b = R_TexDecode( tex, from, to );
+		b->stamp = transient && !b->heap ? r_ring_frame - 1 : r_ring_frame;
+	}
+	else if( !transient )
+		b->stamp = r_ring_frame;
+	return b;
+}
+
+pixel_t *R_TexPix( image_t *tex, int mip )
+{
+	if( !tex->rp_idx )
+		return tex->pixels[mip];
+	return R_TexEnt( tex, mip, mip, 0 )->lv[mip];
+}
+
+pixel_t *R_TexAlpha( image_t *tex )
+{
+	if( !tex->rp_idx )
+		return tex->alpha_pixels;
+	if( !FBitSet( tex->rp_bits, RP_TB_ALPHA ))
+		return NULL;
+	return R_TexEnt( tex, 0, 0, 0 )->alpha;
+}
+
+pixel_t *const *R_TexLevels( image_t *tex, int transient )
+{
+	if( !tex->rp_idx )
+		return tex->pixels;
+	return R_TexEnt( tex, 0, 3, transient )->lv;
+}
+
+pixel_t *R_SkinPix( void )
+{
+	if( !r_affinetridesc.pskin && r_skin_img )
+		r_affinetridesc.pskin = r_skin_alpha ? R_TexAlpha( r_skin_img ) : R_TexPix( r_skin_img, 0 );
+	return r_affinetridesc.pskin;
+}
+
+/* A texture's storage freed (its slot and name kept). */
+static void R_TexRelease( image_t *tex )
+{
+	r_tent_t *b = (r_tent_t *)tex->rp_ent;
+
+	if( b )
+	{
+		if( b->heap )
+			b->owner = NULL;
+		else
+			R_TentDrop( b );
+		tex->rp_ent = NULL;
+	}
+	for( int i = 0; i < 4; i++ )
+	{
+		if( tex->pixels[i] )
+			Mem_Free( tex->pixels[i] );
+		tex->pixels[i] = NULL;
+	}
+	if( tex->alpha_pixels )
+		Mem_Free( tex->alpha_pixels );
+	tex->alpha_pixels = NULL;
+	if( tex->rp_idx )
+		Mem_Free( tex->rp_idx );
+	if( tex->rp_pal )
+		Mem_Free( tex->rp_pal );
+	tex->rp_idx = NULL;
+	tex->rp_pal = NULL;
+	if( r_skin_img == tex )
+	{
+		r_skin_img = NULL;
+		r_affinetridesc.pskin = NULL;
+	}
+}
+
+/* `n` RGBA texels as 8-bit indices and their colours, when there are at
+   most 256 and that is smaller than `full` bytes (the 16-bit levels). */
+static qboolean R_TexPalettize( image_t *tex, const byte *data, uint n, size_t full )
+{
+	uint32_t key[512], pal[256], last = 0;
+	byte     val[512], occ[512], lastv = 0;
+	int      np = 0, have = 0;
+
+	memset( occ, 0, sizeof( occ ));
+	for( int pass = 0; pass < 2; pass++ )
+	{
+		have = 0;
+		for( uint i = 0; i < n; i++ )
+		{
+			uint32_t c, h;
+
+			memcpy( &c, data + i * 4, 4 );
+			if( !have || c != last )
+			{
+				h = ( c * 2654435761u ) >> 23;
+				while( occ[h] && key[h] != c )
+					h = ( h + 1 ) & 511;
+				if( !occ[h] )
+				{
+					if( np == 256 )
+						return false;
