+static void RP_LnMake( const model_t *m )
+{
+	RP_LightNewMap( );
+	rp_ln.nodes = m->nodes;
+	rp_ln.numnodes = m->numnodes;
+	rp_ln.made = 1;
+	if( FBitSet( m->flags, MODEL_QBSP2 ) || m->numnodes <= 0 || m->numnodes > 32767 || !m->nodes )
+		return;
+
+	rp_lnode_t *ln = malloc( sizeof( *ln ) * m->numnodes );
+
+	if( !ln )
+		return;
+	for( int i = 0; i < m->numnodes; i++ )
+	{
+		const mnode_t  *nd = &m->nodes[i];
+		const mplane_t *pl = nd->plane;
+
+		if( !pl )
+		{
+			free( ln );
+			return;
+		}
+		ln[i].d = RP_LFix( pl->dist, 16 );
+		if( pl->type < 3 )
+		{
+			ln[i].n[0] = RP_LN_AXIAL + pl->type;
+			ln[i].n[1] = ln[i].n[2] = 0;
+		}
+		else
+		{
+			for( int k = 0; k < 3; k++ )
+				ln[i].n[k] = RP_LFix( pl->normal[k], 30 ); /* within +-2^30: never RP_LN_AXIAL's range */
+		}
+		for( int side = 0; side < 2; side++ )
+		{
+			const mnode_t *c = node_child( nd, side, m );
+
+			if( !c || c->contents < 0 )
+				ln[i].child[side] = -1;
+			else if( c >= m->nodes && c < m->nodes + m->numnodes )
+				ln[i].child[side] = (int16_t)( c - m->nodes );
+			else
+			{
+				free( ln );
+				return;
+			}
+		}
+		ln[i].firstsurf = node_firstsurface( nd, m );
+		ln[i].numsurf = node_numsurfaces( nd, m );
+	}
+	rp_ln.ln = ln;
+
+	/* the lightmap vectors by texinfo, if every surface's are its texinfo's */
+	int32_t ( *lm )[2][4] = m->numtexinfo > 0 ? malloc( sizeof( *lm ) * m->numtexinfo ) : NULL;
+	uint8_t *seen = m->numtexinfo > 0 ? calloc( m->numtexinfo, 1 ) : NULL;
+	int      ok = lm && seen && m->texinfo && m->surfaces;
+
+	for( int s = 0; ok && s < m->numsurfaces; s++ )
+	{
+		const msurface_t *surf = &m->surfaces[s];
+		int32_t           v[2][4];
+		ptrdiff_t         ti = surf->texinfo - m->texinfo;
+
+		if( !surf->info || !surf->texinfo || ti < 0 || ti >= m->numtexinfo )
+		{
+			ok = 0;
+			break;
+		}
+		for( int a = 0; a < 2; a++ )
+			for( int k = 0; k < 4; k++ )
+				v[a][k] = RP_LFix( surf->info->lmvecs[a][k], 16 );
+		if( !seen[ti] )
+		{
+			memcpy( lm[ti], v, sizeof( v ));
+			seen[ti] = 1;
+		}
+		else if( memcmp( lm[ti], v, sizeof( v )))
+			ok = 0;
+	}
+	free( seen );
+	if( ok )
+		rp_ln.lm = lm;
+	else
+		free( lm );
+}
