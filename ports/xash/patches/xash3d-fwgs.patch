+static int RP_TransKeyCompare( const rp_tkey_t *a, const rp_tkey_t *b )
+{
+	if( a->dist1 > b->dist2 )
+		return -1;
+	if( a->dist1 < b->dist2 )
+		return 1;
+	if( a->rank > b->rank )
+		return 1;
+	if( a->rank < b->rank )
+		return -1;
+	return 0;
