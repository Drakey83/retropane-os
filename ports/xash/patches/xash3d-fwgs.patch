+static uint64_t RP_Fnv( uint64_t h, const void *p, size_t n )
+{
+	const byte *b = p;
+
+	for( size_t i = 0; i < n; i++ )
+		h = ( h ^ b[i] ) * 0x100000001B3ULL;
+	return h;
