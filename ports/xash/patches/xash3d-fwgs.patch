+/*
+RetroPane kit 103 (ADR-0040 step 7c, docs/design/ref-rp.md "Step 7c"): the
+world walked over the cooked map (r_emit.c). When the view enters another
+cluster (R_MarkLeaves gives tr.visframecount a new number), the nodes and
+leaves of the PVS are copied, in preorder, into one compact array, 32
+bytes (a cache line) a record: the box in whole units, the plane, the
+faces, the children's places in the array. Each frame walks that array
+with R_RecursiveWorldNode's own tests, its integers made once at the cook
+(the planes' rp_fixq values, the boxes' 16.16 as whole units), in its
+order: the same faces, the same order, the same words. The faces' "seen
+this frame" marks are a table of their own (nothing else reads
+msurface_t's visframe), the leaves' keys kept for a frame drawn both ways.
+*/
+typedef struct
+{
+	int16_t  box[6];
+	uint16_t plane;     // RP_VN_LEAF a leaf; RP_VN_AXIAL | type an axial plane (its distance in `d`); else the plane's index
+	uint16_t n;         // the node's faces, or the leaf's
+	uint32_t first;     // the first face, or the leaf's first mark
+	int32_t  child[2];  // places in the array, -1 none
+	int32_t  d;         // an axial plane's distance (16.16); a leaf's index in the model, RP_VN_EFRAGS if it holds efrags
+} rp_vnode_t;
+
+#define RP_VN_LEAF   0xFFFF
+#define RP_VN_AXIAL  0x8000
+#define RP_VN_EFRAGS (int32_t)0x40000000
+extern int rp_efrag_gen; // engine/client/cl_efrag.c: a new number when a leaf's efrags change
+static int rp_vn_efrag_gen;
+
+static rp_vnode_t *rp_vn;
+static int         rp_vn_n, rp_vn_cap, rp_vn_max, rp_vn_vis = -1, rp_vn_ok;
+
+/* room for one more record: the array grows by doubling up to the map's
+   nodes and leaves (run 153: sized for all of them at once it was memory
+   the fight's map lacked; a cluster's PVS is a fraction, ~500 records) */
+static int RP_VisRoom( void )
+{
+	rp_vnode_t *grown;
+	int         cap;
+
+	if( rp_vn_n < rp_vn_cap )
+		return 1;
+	if( rp_vn_cap >= rp_vn_max )
+		return 0;
+	cap = rp_vn_cap * 2 > rp_vn_max ? rp_vn_max : rp_vn_cap * 2;
+	grown = realloc( rp_vn, sizeof( *rp_vn ) * cap );
+	if( !grown )
+		return 0;
+	rp_vn = grown;
+	rp_vn_cap = cap;
+	return 1;
+}
+static uint32_t    rp_vn_serial;    // the cooked map rp_vn was made from
+static int        *rp_fstamp;       // a face's frame (tr.framecount) when a leaf of the walk holds it
+static int         rp_fstamp_n;
+unsigned           rp_vn_counts[4]; // kit 103: the arrays made, records in them, faces off the screen not sent, faces sent (r_emit.c's report)
+
+/* the record and the PVS under it, in preorder: its place, -1 not in the
+   PVS, -2 the array full (a damaged cooked file: the engine's walk) */
+static int32_t RP_VisBuild( const rp_cooked_t *ck, const model_t *mod, int32_t c )
+{
+	rp_vnode_t *v;
+	int32_t     k;
+
+	if( c < 0 )
+	{
+		const rp_cleaf_t *cl = &ck->leafs[-1 - c];
+		const mleaf_t    *l = &mod->leafs[-1 - c];
+
+		if( l->contents == CONTENTS_SOLID || l->visframe != tr.visframecount )
+			return -1;
+		if( !RP_VisRoom( ) || cl->nmarks > 0xFFFF )
+			return -2;
+		k = rp_vn_n++;
+		v = &rp_vn[k];
+		memcpy( v->box, cl->box, sizeof( v->box ));
+		v->plane = RP_VN_LEAF;
+		v->n = (uint16_t)cl->nmarks;
+		v->first = cl->firstmark;
+		v->child[0] = v->child[1] = -1;
+		v->d = ( -1 - c ) | ( l->efrags ? RP_VN_EFRAGS : 0 );
+		return k;
+	}
+	else
+	{
+		const rp_cnode_t *cn = &ck->nodes[c];
+		const mnode_t    *node = &mod->nodes[cn->orig];
+		int32_t           a, b;
+
+		if( node->contents == CONTENTS_SOLID || node->visframe != tr.visframecount )
+			return -1;
+		if( !RP_VisRoom( ))
+			return -2;
+		k = rp_vn_n++;
+		v = &rp_vn[k];
+		memcpy( v->box, cn->box, sizeof( v->box ));
+		// an axial plane (most of a map's) inline: its record not read a frame
+		if( ck->planes[cn->plane].type < 3 )
+		{
+			v->plane = RP_VN_AXIAL | ck->planes[cn->plane].type;
+			v->d = ck->planes[cn->plane].d;
+		}
+		else if( cn->plane >= RP_VN_AXIAL )
+			return -2;
+		else
+		{
+			v->plane = cn->plane;
+			v->d = 0;
+		}
+		v->n = cn->nfaces;
+		v->first = cn->firstface;
+		// a child's place is always past its parent's in the cooked file
+		// (checked when read), so this recursion ends
+		if(( a = RP_VisBuild( ck, mod, cn->child[0] )) == -2 || ( b = RP_VisBuild( ck, mod, cn->child[1] )) == -2 )
+			return -2;
+		rp_vn[k].child[0] = a;
+		rp_vn[k].child[1] = b;
+		return k;
+	}
+}
+
+/* the PVS's array for this cluster (empty when the root is not in it, as
+   the engine's walk then draws nothing): 0 if it cannot be made (the
+   engine's walk) */
+static int RP_VisArray( const rp_cooked_t *ck, const model_t *mod )
+{
+	if( rp_vn && rp_vn_vis == tr.visframecount && rp_vn_serial == ck->serial && rp_vn_efrag_gen == rp_efrag_gen )
+		return rp_vn_ok;
+	if( rp_vn_serial != ck->serial || !rp_vn )
+	{
+		free( rp_vn );
+		free( rp_fstamp );
+		rp_vn_max = ck->nnodes + ck->nleafs;
+		rp_vn_cap = rp_vn_max < 512 ? rp_vn_max : 512;
+		rp_vn = malloc( sizeof( *rp_vn ) * rp_vn_cap );
+		rp_fstamp_n = ck->nfaces;
+		rp_fstamp = calloc( rp_fstamp_n ? rp_fstamp_n : 1, sizeof( *rp_fstamp ));
+		if( !rp_vn || !rp_fstamp )
+		{
+			free( rp_vn );
+			free( rp_fstamp );
+			rp_vn = NULL;
+			rp_fstamp = NULL;
+			return 0;
+		}
+		for( int i = 0; i < rp_fstamp_n; i++ )
+			rp_fstamp[i] = -1;
+		rp_vn_serial = ck->serial;
+	}
+	rp_vn_vis = tr.visframecount;
+	rp_vn_efrag_gen = rp_efrag_gen;
+	rp_vn_n = 0;
+	rp_vn_ok = RP_VisBuild( ck, mod, 0 ) != -2;
+	if( !rp_vn_ok )
+	{
+		rp_vn_n = 0;
+		return 0;
+	}
+	rp_vn_counts[0]++;
+	rp_vn_counts[1] += rp_vn_n;
+	return 1;
+}
+
+/* a box corner (whole units at the three indexes) against frustum plane i,
+   2^46: RP_WalkPlane's products, the same integers */
+static inline int64_t RP_CookPlane( const int16_t *box, const int *pindex, int i )
+{
+	return (int64_t)rp_wn.n[i][0] * ((int32_t)box[pindex[0]] * 65536 )
+		+ (int64_t)rp_wn.n[i][1] * ((int32_t)box[pindex[1]] * 65536 )
+		+ (int64_t)rp_wn.n[i][2] * ((int32_t)box[pindex[2]] * 65536 )
+		- rp_wn.d[i];
+}
+
+/* a face's box wholly outside one of the frustum's planes still in play
+   (the node tests' own integers and margin): nothing of it on the screen */
+static inline int RP_FaceOff( const int16_t *box, int clipflags )
+{
+	for( int i = 0; i < 4; i++ )
+		if(( clipflags & ( 1 << i )) && RP_CookPlane( box, qfrustum.pfrustum_indexes[i], i ) < -RP_WN_MARGIN )
+			return 1;
+	return 0;
+}
+
+static void RP_CookWalk( const rp_cooked_t *ck, model_t *mod, int32_t k, int clipflags )
+{
+	const rp_vnode_t *v = &rp_vn[k];
+	int64_t           dot;
+	int               side;
+
+	// both children's records asked for now (a hint): the walk reaches
+	// them after this node's tests, the misses overlapped
+	if( v->child[0] >= 0 )
+		__builtin_prefetch( &rp_vn[v->child[0]] );
+	if( v->child[1] >= 0 )
+		__builtin_prefetch( &rp_vn[v->child[1]] );
+
+	if( clipflags )
+	{
+		for( int i = 0; i < 4; i++ )
+		{
+			int *pindex;
+
+			if( !( clipflags & ( 1 << i )))
+				continue;
+			pindex = qfrustum.pfrustum_indexes[i];
+			if( RP_CookPlane( v->box, pindex, i ) < -RP_WN_MARGIN )
+				return;
+			if( RP_CookPlane( v->box, pindex + 3, i ) > RP_WN_MARGIN )
+				clipflags &= ~( 1 << i );
+		}
+	}
+
+	if( v->plane == RP_VN_LEAF )
+	{
+		mleaf_t        *pleaf = &mod->leafs[v->d & ~RP_VN_EFRAGS];
+		const uint16_t *mark = &ck->marks[v->first];
+
+		for( int c = v->n; c; c--, mark++ )
+			rp_fstamp[*mark] = tr.framecount;
+		// a leaf with efrags known from the array (made again when any
+		// leaf's efrags change: rp_efrag_gen), so no other leaf is read
+		if( v->d & RP_VN_EFRAGS )
+			gEngfuncs.R_StoreEfrags( &pleaf->efrags, tr.realframecount );
+		if( rp_both )
+			LEAF_KEY( pleaf ) = r_currentkey;
+		r_currentkey++;
+		return;
+	}
+	else
+	{
+		int c = v->n;
+
+		if( v->plane & RP_VN_AXIAL )
+			dot = ((int64_t)rp_wn.o[v->plane & 3] - v->d ) << 30;
+		else
+		{
+			const rp_cplane_t *plane = &ck->planes[v->plane];
+
+			dot = (int64_t)plane->n[0] * rp_wn.o[0] + (int64_t)plane->n[1] * rp_wn.o[1]
+				+ (int64_t)plane->n[2] * rp_wn.o[2] - ((int64_t)plane->d << 30 );
+		}
+		side = dot >= 0 ? 0 : 1;
+
+		if( v->child[side] >= 0 )
+			RP_CookWalk( ck, mod, v->child[side], clipflags );
+
+		if( c )
+		{
+			uint32_t    f = v->first;
+			msurface_t *surf = mod->surfaces + f;
+			// the faces on the eye's side (RP_CK_PLANEBACK as SURF_PLANEBACK)
+			int         want = dot < -RP_WN_BACK ? RP_CK_PLANEBACK : dot > RP_WN_BACK ? 0 : -1;
+
+			if( want >= 0 )
+			{
+				do
+				{
+					if(( ck->faces[f] & RP_CK_PLANEBACK ) == want && rp_fstamp[f] == tr.framecount )
+					{
+						// kit 103: a face in a leaf the view touches but
+						// itself wholly off the screen is not transformed
+						// or sent (the TA would clip all of it)
+						if( clipflags && rp_facecull && !rp_both && RP_FaceOff( ck->fbox[f], clipflags ))
+							rp_vn_counts[2]++;
+						else
+						{
+							if( c > 1 )
+								RP_FaceAhead( surf + 1 ); // kit 69's hint
+							R_RenderFace( surf, clipflags );
+							rp_vn_counts[3]++;
+						}
+					}
+					surf++;
+					f++;
+				}
+				while( --c );
+			}
+			r_currentkey++;
+		}
+
+		if( v->child[!side] >= 0 )
+			RP_CookWalk( ck, mod, v->child[!side], clipflags );
+	}
+}
